<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Duplicate Cleaner</title>

<HTA:APPLICATION
  APPLICATIONNAME="DuplicateCleaner"
  ICON="DuplicateCleaner-K.ico"
  BORDER="thin"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
/>

<style>

html,
body{
    margin:0;
    padding:0;
    width:100%;
    min-width:320px;
    height:100%;
    min-height:100vh;
    overflow:hidden;

    background:
        radial-gradient(circle at top left, rgba(59,130,246,.18), transparent 30%),
        linear-gradient(135deg, #0d1726 0%, #111f32 100%);
    color:#ffffff;

    font-family:"Segoe UI",Arial,sans-serif;
    font-size:13px;
}

*{
    box-sizing:border-box;
}

.header{
    height:72px;
    display:-ms-flexbox;
    display:flex;
    -ms-flex-align:center;
    -ms-flex-pack:justify;
    align-items:center;
    justify-content:space-between;
    padding:0 22px;
    background:linear-gradient(180deg, #172437 0%, #101c2d 100%);
    border-bottom:1px solid rgba(176, 196, 224, .22);
    backdrop-filter:blur(12px);
    box-shadow:0 10px 30px rgba(2,6,23,.38);
}

.header-left{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-align:center;
    align-items:center;
    gap:12px;
}

.header-context{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-align:center;
    align-items:center;
    gap:10px;
}

.connection-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#35d07f;
    box-shadow:0 0 0 4px rgba(53,208,127,.12);
}

.brand-mark{
    width:38px;
    height:38px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    font-size:14px;
    background:linear-gradient(135deg, #4f9bff, #6ea8fe);
    color:#fff;
    box-shadow:0 10px 22px rgba(37,99,235,.5);
}

.brand-copy{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-direction:column;
    flex-direction:column;
    line-height:1.1;
}

.logo{
    font-size:21px;
    font-weight:700;
    letter-spacing:0;
    color:#ffffff;
}

.brand-subtitle{
    color:#ffffff;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.12em;
}

.user{
    color:#ffffff;
    font-size:12px;
    padding:8px 12px;
    border-radius:999px;
    border:1px solid rgba(148,163,184,.18);
    background:rgba(15,25,39,.5);
}

.container{
    display:-ms-flexbox;
    display:flex;
    height:calc(100vh - 72px - 32px);
    min-height:0;
}

.sidebar{
    width:240px;
    min-width:200px;
    background:linear-gradient(180deg, #162336 0%, #101d2f 100%);
    border-right:1px solid rgba(176, 196, 224, .22);
    padding:18px 14px;
    overflow:auto;
    backdrop-filter:blur(6px);
}

.nav-group-label{
    padding:14px 12px 7px;
    color:#93a8c2;
    font-size:9px;
    font-weight:700;
    letter-spacing:.1em;
    text-transform:uppercase;
}

.content{
    -ms-flex:1 1 auto;
    flex:1;
    min-width:0;
    overflow:auto;
    padding:24px;
    background:linear-gradient(180deg, #dfe5ec 0%, #d3d9e0 100%);
    color:#111827;
}

.page{
    animation: fadeIn .25s ease;
}

.page-heading{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-pack:justify;
    -ms-flex-align:start;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;
    margin-bottom:16px;
}

.page-heading h1{
    margin:0;
    color:#142235;
    font-size:22px;
    font-weight:700;
}

.page-heading p{
    margin:7px 0 0;
    color:#526174;
    font-size:12px;
}

.eyebrow{
    color:#397856 !important;
    font-size:9px !important;
    font-weight:700;
    letter-spacing:.1em;
    text-transform:uppercase;
    margin:0 0 7px !important;
}

.state-pill{
    display:-ms-inline-flexbox;
    display:inline-flex;
    -ms-flex-align:center;
    align-items:center;
    gap:8px;
    padding:7px 10px;
    border:1px solid #b7c4d1;
    border-radius:6px;
    background:#f5f7f9;
    color:#26384a;
    font-size:11px;
    white-space:nowrap;
}

@keyframes fadeIn {
    from { opacity:0; transform:translateY(4px); }
    to { opacity:1; transform:translateY(0); }
}

.nav-item{
    display:block;
    width:100%;
    padding:12px 14px;
    border-radius:7px;
    margin-bottom:4px;
    cursor:pointer;
    color:#ffffff;
    font-weight:600;
    text-align:left;
    background:transparent;
    box-shadow:none;
    transition:background .16s ease, border-color .16s ease;
    border:1px solid transparent;
}

.nav-item:hover{
    background:rgba(148, 163, 184, .08);
    color:#ffffff;
    border-color:rgba(148,163,184,.12);
    transform:none;
}

.nav-item.active{
    background:linear-gradient(135deg, rgba(59,130,246,.22), rgba(96,165,250,.12));
    border-color:rgba(96,165,250,.45);
    color:#fff;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.08), 0 10px 18px rgba(37,99,235,.18);
}

.cards{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-wrap:wrap;
    flex-wrap:wrap;
    gap:16px;
}

.card{
    -ms-flex:1 1 180px;
    flex:1 1 180px;
    min-width:0;
    background:linear-gradient(180deg, #1a2b40 0%, #132234 100%);
    border:1px solid rgba(167, 191, 221, .28);
    border-radius:8px;
    padding:20px;
    transition:all .2s ease;
    box-shadow:0 18px 48px rgba(2,6,23,.55);
}

.card .title,
.card .value,
.card .subtitle,
.card *{
    color:#ffffff;
}

.card:hover{
    border-color:rgba(96,165,250,.5);
    box-shadow:0 15px 34px rgba(15,23,42,.36);
}

.title{
    color:#e6eefc;
    font-size:10px;
    letter-spacing:.12em;
    text-transform:uppercase;
}

.value{
    font-size:28px;
    margin-top:10px;
    font-weight:700;
    letter-spacing:0;
    color:#fff;
}

.panel{
    margin-top:16px;
    background:linear-gradient(180deg, #1b2d42 0%, #132334 100%);
    border:1px solid rgba(169, 192, 220, .24);
    border-radius:8px;
    padding:18px;
    box-shadow:0 18px 48px rgba(2,6,23,.55);
}

.panel h3{
    margin:0 0 18px;
    font-size:16px;
    letter-spacing:0;
    color:#ffffff;
}

.panel-note,
.metric-note{
    color:#bdcadd;
    font-size:11px;
}

.panel-note{
    margin:-7px 0 16px;
}

.metric-note{
    margin-top:7px;
}

.panel-heading{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-pack:justify;
    -ms-flex-align:center;
    justify-content:space-between;
    align-items:center;
    gap:16px;
}

.panel-heading h3{
    margin-bottom:14px;
}

.progress-meta{
    display:-ms-flexbox;
    display:flex;
    flex-wrap:wrap;
    -ms-flex-pack:justify;
    justify-content:space-between;
    gap:12px;
    margin:8px 0 0;
    color:#d7e1ee;
    font-size:11px;
}

.result-toolbar{
    display:-ms-flexbox;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:10px;
    margin-top:14px;
}

.result-toolbar input,
.result-toolbar select{
    width:auto;
    min-width:150px;
    flex:1 1 150px;
    padding:9px 11px;
    font-size:11px;
}

.search-filter-grid{
    display:-ms-flexbox;
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:10px;
}

.search-filter-grid label{
    -ms-flex:1 1 45%;
    flex:1 1 45%;
    min-width:140px;
    color:#d7e1ee;
    font-size:10px;
}

.search-filter-grid input{
    margin-top:5px;
    padding:8px 9px;
    font-size:11px;
}

.search-filter-grid textarea{
    display:block;
    margin-top:5px;
    font-size:11px;
}

#largeFilesPage .search-filter-grid label{
    color:#d7e1ee;
}

#largeFilesPage .large-file-recovery-actions select{
    width:auto;
    min-width:170px;
    flex:1 1 200px;
}

#largeFilesPage .large-file-recovery-actions button{
    flex:0 0 auto;
}

.result-summary{
    color:#d7e1ee;
    font-size:11px;
}

.group-heading td{
    background:#203650;
    color:#fff;
    font-weight:700;
    white-space:normal;
}

.keep-choice,
.remove-choice{
    width:auto;
    margin:0 5px 0 0;
    vertical-align:middle;
}

.keep-label{
    color:#9be9a8;
    font-size:10px;
    white-space:normal;
}

.scan-controls{
    display:inline-flex;
    gap:8px;
    margin-left:auto;
}

.scan-controls button{
    padding:7px 11px;
    font-size:10px;
}

.selection-summary{
    color:#d7e1ee;
    font-size:11px;
    align-self:center;
}

.table-wrap{
    width:100%;
    overflow:auto;
}

.empty-state{
    padding:26px 14px;
    color:#64748b;
    text-align:center;
}

.search-results-table .empty-state{
    color:#d7e1ee;
    white-space:normal;
    text-overflow:clip;
    height:auto;
}

.result-table th,
.result-table td{
    padding:8px 10px;
    font-size:11px;
    line-height:1.35;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.result-table th{
    font-size:9px;
}

.duplicate-bulk-choice{
    display:inline-block;
    margin-top:6px;
    font-size:9px;
    font-weight:400;
    white-space:nowrap;
    cursor:pointer;
}

.duplicate-bulk-choice input{
    width:auto;
    margin:0 4px 0 0;
    vertical-align:middle;
}

.result-table .name-column{
    width:145px;
}

.result-table .size-column{
    width:72px;
}

.result-table .hash-column{
    width:170px;
}

.result-table .time-column{
    width:145px;
}

.result-table .action-column{
    width:112px;
}

.search-result-link{
    color:#ffffff;
    text-decoration:none;
}

.search-result-link.path-link{
    color:#9fd4ff;
}

.search-result-link:hover{
    color:#ffffff;
    text-decoration:underline;
}

.analysis-grid{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-wrap:wrap;
    flex-wrap:wrap;
    gap:1px;
    overflow:hidden;
    border:1px solid rgba(169,192,220,.2);
    border-radius:7px;
    background:rgba(169,192,220,.2);
}

.analysis-grid > div{
    display:-ms-flexbox;
    display:flex;
    -ms-flex:1 1 45%;
    flex:1 1 45%;
    min-width:0;
    flex-direction:column;
    gap:8px;
    padding:14px 16px;
    background:#17283c;
}

.analysis-grid span{
    color:#b7c6dc;
    font-size:10px;
    text-transform:uppercase;
}

.analysis-grid strong{
    overflow-wrap:anywhere;
    color:#fff;
    font-size:14px;
    font-weight:600;
}

.dashboard-panels,
.workspace-grid{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-wrap:wrap;
    flex-wrap:wrap;
    gap:16px;
    align-items:start;
}

.dashboard-panels .panel,
.workspace-grid .panel{
    -ms-flex:1 1 300px;
    flex:1 1 300px;
    min-width:0;
    margin-top:0;
}

.dashboard-panels,
.cards + .workspace-grid{
    margin-top:16px;
}

.task-results{
    -ms-flex:1.5 1 420px !important;
    flex:1.5 1 420px !important;
    min-width:0;
}

.task-controls{
    -ms-flex:1 1 260px !important;
    flex:1 1 260px !important;
}

.task-results .table-wrap{
    max-height:calc(100vh - 330px);
    min-height:180px;
}

.task-results table{
    margin-top:12px;
}

.task-results .log{
    height:150px;
}

.log-preview{
    height:auto !important;
    max-height:360px;
    min-height:140px;
    margin:10px 0 0;
    overflow:auto;
    white-space:pre-wrap;
    overflow-wrap:anywhere;
    color:#e7eef8;
}

.task-controls .exclusion-list{
    height:124px;
}

textarea.keyword-list{
    min-height:76px;
    height:88px;
    margin-top:1px;
    margin-bottom: 10px;
    resize:vertical;
}

@supports (display:grid){
    .cards{
        display:grid;
        grid-template-columns:repeat(4, minmax(0, 1fr));
    }

    .analysis-grid{
        display:grid;
        grid-template-columns:repeat(2, minmax(0, 1fr));
    }

    .dashboard-panels,
    .workspace-grid{
        display:grid;
        grid-template-columns:minmax(250px, .8fr) minmax(0, 1.45fr);
    }

    .dashboard-panels .panel,
    .workspace-grid .panel,
    .task-controls,
    .task-results{
        flex:none;
    }
}

.folder-row,
.action-row,
.inline-actions{
    display:-ms-flexbox;
    display:flex;
    -ms-flex-wrap:wrap;
    gap:10px;
    align-items:center;
    flex-wrap:wrap;
}

.folder-row > *,
.action-row > *,
.inline-actions > *,
.result-toolbar > *{
    margin:0 8px 8px 0;
}

.folder-row input{
    -ms-flex:1 1 auto;
    flex:1;
    min-width:0;
}

.folder-row select{
    width:auto;
    flex:0 1 190px;
    min-width:130px;
}
.folder-row button{
    flex:0 0 auto;
    white-space:nowrap;
}

input,
textarea,
select{
    width:100%;
    box-sizing:border-box;
    background-color:#101d30;
    background-image:linear-gradient(180deg, #14243a 0%, #101d30 100%);
    color:#ffffff;
    border:1px solid #405570;
    border-radius:7px;
    padding:9px 11px;
    font-family:"Segoe UI",Arial,sans-serif;
    font-size:12px;
    transition:border-color .16s ease, box-shadow .16s ease, background-color .16s ease;
}

input::placeholder,
textarea::placeholder{
    color:#aebdd0;
}

select{
    cursor:pointer;
}

select option{
    background-color:#14243a;
    color:#f2f6fc;
}

select option:hover{
    background-color:#24528a;
    color:#ffffff;
}

input[type="checkbox"],
input[type="radio"]{
    width:auto;
    padding:0;
    background:none;
}

input:hover,
textarea:hover,
select:hover{
    border-color:#6b819e;
    background-color:#172840;
    background-image:none;
}

input:focus,
textarea:focus,
select:focus{
    outline:none;
    border-color:#68a9f8;
    box-shadow:0 0 0 2px rgba(59,130,246,.2);
    background-color:#101d30;
    background-image:none;
}

select:focus option:checked,
select option:checked{
    background-color:#24528a;
    color:#ffffff;
}

button{
    background:#2563a8;
    color:#ffffff;
    border:1px solid #3476bb;
    border-radius:6px;
    padding:8px 13px;
    cursor:pointer;
    font-family:"Segoe UI",Arial,sans-serif;
    font-size:11px;
    font-weight:600;
    letter-spacing:0;
    transition:background-color .16s ease, border-color .16s ease, box-shadow .16s ease, transform .16s ease;
    box-shadow:0 1px 2px rgba(0,0,0,.16);
}

.content button:not(.success):not(.danger):not(.warning){
    background:#263b53;
    border-color:#526a86;
    color:#f4f7fb;
    box-shadow:0 1px 2px rgba(15,23,42,.12);
}

button:hover{
    background:#3275b9;
    border-color:#5594d1;
    box-shadow:0 2px 5px rgba(15,23,42,.2);
    transform:translateY(-1px);
}

.content button:not(.success):not(.danger):not(.warning):hover{
    background:#344f70;
    border-color:#6b85a3;
}

button:focus{
    outline:2px solid #8bc1ff;
    outline-offset:2px;
}

button:active{
    transform:translateY(0);
    box-shadow:inset 0 1px 2px rgba(0,0,0,.22);
}

button:disabled{
    opacity:.55;
    cursor:default;
    transform:none;
    box-shadow:none;
    background:#39485b;
    border-color:#526174;
}

.success{
    background:#18794e;
    border-color:#23895d;
    box-shadow:0 1px 2px rgba(22,101,52,.2);
}

.success:hover{
    background:#20935f;
    border-color:#35a875;
}

.danger{
    background:#a8323e;
    border-color:#c04a55;
    box-shadow:0 1px 2px rgba(127,29,29,.2);
}

.danger:hover{
    background:#bf3d49;
    border-color:#d76670;
}

.warning{
    background:#93600b;
    border-color:#b27a16;
    box-shadow:0 1px 2px rgba(120,73,10,.2);
}

.warning:hover{
    background:#aa7210;
    border-color:#ce9228;
}

.success:disabled,
.danger:disabled,
.warning:disabled{
    background:#39485b;
    border-color:#526174;
}

.progress{
    width:100%;
    height:12px;
    background:rgba(11,18,32,.9);
    border:1px solid rgba(148,163,184,.15);
    border-radius:999px;
    overflow:hidden;
    margin:6px 0 18px;
}

.progressbar{
    width:0%;
    height:100%;
    background:linear-gradient(90deg, #3b82f6, #60a5fa, #93c5fd);
    box-shadow:0 0 16px rgba(96,165,250,.55);
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:18px;
    background:rgba(11,18,32,.2);
    border-radius:10px;
    overflow:hidden;
    table-layout:fixed;
}

th{
    text-align:left;
    background:rgba(15, 23, 42, .9);
    color:#e6eefc;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.08em;
    padding:12px 14px;
    border-bottom:1px solid rgba(148,163,184,.18);
}

td{
    padding:12px 14px;
    border-top:1px solid rgba(148,163,184,.12);
    color:#ffffff;
    overflow-wrap:anywhere;
    word-break:break-word;
}

tr:hover{
    background:rgba(148,163,184,.04);
}

.log{
    background:linear-gradient(180deg, #0d1726 0%, #101d2f 100%);
    border:1px solid rgba(178, 201, 230, .24);
    border-radius:10px;
    padding:12px 14px;
    height:220px;
    overflow:auto;
    font-family:Consolas, "Courier New", monospace;
    color:#9be9a8;
    line-height:1.5;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.04);
    font-size:11px;
}

.statusbar{
    position:fixed;
    bottom:0;
    left:240px;
    right:0;
    height:32px;
    background:rgba(15,23,42,.9);
    border-top:1px solid rgba(148,163,184,.18);
    display:flex;
    align-items:center;
    padding-left:14px;
    color:#ffffff;
    font-size:11px;
    letter-spacing:.02em;
    backdrop-filter:blur(8px);
    z-index:5;
}

textarea{
    min-height:220px;
    resize:vertical;
}

textarea.exclusion-list{
    min-height:120px;
    height:140px;
    margin-top:8px;
}

@media (max-width: 900px){
    html,
    body{
        height:auto;
        min-height:100%;
        overflow:auto;
    }

    .header{
        height:auto;
        min-height:72px;
        padding:14px 16px;
        gap:12px;
        -ms-flex-align:start;
        -ms-flex-wrap:wrap;
        align-items:flex-start;
        flex-wrap:wrap;
    }

    .container{
        display:-ms-flexbox;
        -ms-flex-direction:column;
        flex-direction:column;
        height:auto;
        min-height:0;
        overflow:visible;
        padding-bottom:32px;
    }

    .sidebar{
        width:100%;
        min-width:0;
        border-right:none;
        border-bottom:1px solid rgba(148, 163, 184, .18);
        display:flex;
        display:-ms-flexbox;
        -ms-flex-wrap:wrap;
        flex-wrap:wrap;
        gap:8px;
        padding:12px;
    }

    .nav-group-label{
        flex:1 0 100%;
        padding:5px 4px 0;
    }

    .nav-item{
        -ms-flex:1 1 140px;
        flex:1 1 140px;
        margin-bottom:0;
    }

    .content{
        -ms-flex:1 0 auto;
        flex:1 0 auto;
        min-height:0;
        overflow:visible;
        padding:16px;
    }

    .dashboard-panels,
    .workspace-grid{
        grid-template-columns:minmax(0, 1fr);
    }

    .dashboard-panels > .panel,
    .workspace-grid > .panel{
        -ms-flex:1 1 100%;
        flex-basis:100%;
    }

    .task-results .table-wrap{
        max-height:420px;
    }

    .card{
        width:auto;
    }

    .cards{
        grid-template-columns:repeat(2, minmax(0, 1fr));
    }

    .card{
        flex-basis:calc(50% - 8px);
    }

    .statusbar{
        left:0;
        background:#0f172a;
        box-shadow:0 -4px 12px rgba(2,6,23,.2);
    }
}

@media (max-width: 560px){
    .logo{
        font-size:18px;
    }

    .brand-subtitle{
        letter-spacing:.08em;
    }

    .user{
        display:none;
    }

    .cards{
        gap:12px;
    }

    .card{
        width:100%;
    }

    .cards{
        grid-template-columns:1fr;
    }

    .card{
        flex-basis:100%;
    }

    .analysis-grid{
        grid-template-columns:1fr;
    }

    .analysis-grid > div{
        -ms-flex:1 1 100%;
        flex-basis:100%;
    }

    .page-heading{
        -ms-flex-direction:column;
        flex-direction:column;
        gap:12px;
    }

    .folder-row,
    .inline-actions{
        -ms-flex-direction:column;
        -ms-flex-align:stretch;
        flex-direction:column;
        align-items:stretch;
    }
    .folder-row{
        -ms-flex-direction:row;
        flex-direction:row;
        flex-wrap:nowrap;
        align-items:stretch;
    }

    .content{
        padding:12px;
    }

    .nav-item{
        -ms-flex:1 1 100%;
        flex:1 1 100%;
    }

    .panel{
        padding:16px;
    }

    .page-heading h1{
        font-size:20px;
    }

    .page-heading{
        margin-bottom:12px;
    }

    .table-wrap table{
        min-width:560px;
    }

    .task-results .table-wrap{
        max-height:360px;
    }
}

</style>

</head>

<body>

<div class="header">
    <div class="header-left">
        <div class="brand-mark">DC</div>
        <div class="brand-copy">
            <div class="logo">Duplicate Cleaner</div>
            <div class="brand-subtitle">Enterprise Suite</div>
        </div>
    </div>
    <div class="header-context">
        <span class="connection-dot"></span>
        <span class="user">Local workstation</span>
    </div>
</div>

<div class="container">

    <div class="sidebar">

           <div class="nav-group-label">Workspace</div>
           <button type="button" class="nav-item active" onclick="showPage('dashboardPage',this)">Overview</button>
           <button type="button" class="nav-item" onclick="showPage('searchPage',this)">File Search</button>
           <button type="button" class="nav-item" onclick="showPage('duplicatesPage',this)">Duplicates</button>
           <button type="button" class="nav-item" onclick="showPage('largeFilesPage',this)">Large Files</button>

           <div class="nav-group-label">Records</div>
           <button type="button" class="nav-item" onclick="showPage('reportsPage',this)">Reports</button>
           <button type="button" class="nav-item" onclick="showPage('logsPage',this)">Activity Log</button>

    </div>

    <div class="content">

        <!-- DASHBOARD -->
        <div id="dashboardPage" class="page">

            <div class="page-heading">
                <div>
                    <p class="eyebrow">Operations</p>
                    <h1>Overview</h1>
                    <p>Review scan results, recovery estimates, and cleanup activity across your selected folders.</p>
                </div>
                <span class="state-pill"><span class="connection-dot"></span><span id="operationState">Ready</span></span>
            </div>

            <div class="cards">

                <div class="card">
                    <div class="title">Files Scanned</div>
                    <div class="value" id="filesScanned">0</div>
                    <div class="metric-note">Last completed scan</div>
                </div>

                <div class="card">
                    <div class="title">Duplicates Found</div>
                    <div class="value" id="duplicatesFound">0</div>
                    <div class="metric-note">Review candidates</div>
                </div>

                <div class="card">
                    <div class="title">Recoverable Space</div>
                    <div class="value" id="recoverSpace">0 GB</div>
                    <div class="metric-note">Potentially recoverable</div>
                </div>

                <div class="card">
                    <div class="title">Deleted Files</div>
                    <div class="value" id="deletedFiles">0</div>
                    <div class="metric-note">Removed this run</div>
                </div>

            </div>

            <div class="dashboard-panels">
            <div class="panel">
                <h3>Latest scan analysis</h3>
                <p id="scanAnalysisSummary" class="panel-note">Run a duplicate preview to populate analysis for the selected folder.</p>
                <div class="analysis-grid">
                    <div><span>Scanned location</span><strong id="scanAnalysisPath">No scan yet</strong></div>
                    <div><span>Last run</span><strong id="scanAnalysisTime">Not available</strong></div>
                    <div><span>Duplicate candidates</span><strong id="scanAnalysisDuplicates">0</strong></div>
                    <div><span>Potential recovery</span><strong id="scanAnalysisSpace">0 B</strong></div>
                </div>
            </div>

            <div class="panel">
                <h3>Recent activity</h3>
                <div id="dashboardLog" class="log">Application ready.</div>
            </div>
            </div>

        </div>

        <!-- SEARCH -->

        <div id="searchPage"
             class="page"
             style="display:none;">

            <div class="page-heading">
                <div>
                    <p class="eyebrow">Workspace</p>
                    <h1>File Search</h1>
                    <p>Find files by name or path while honoring your exclusion rules.</p>
                </div>
            </div>

            <div class="workspace-grid">
            <div class="panel task-controls">

                <h3>Search criteria</h3>

                <div class="folder-row">
                    <input id="searchRoot"
                           placeholder="Folder to search in">
                    <button onclick="browseFolderFor('searchRoot','Select Search Folder')">Browse</button>
                </div>
                <select id="searchRecentFolders" onchange="chooseRecentFolder('searchRoot','searchRecentFolders')" aria-label="Recent search folders">
                    <option value="">Recent folders</option>
                </select>

                <div style="margin-top:12px;">
                    <h3>Search keywords</h3>
                    <textarea id="searchText" class="keyword-list"
                              placeholder="One or more terms; separate with commas, semicolons, or new lines"
                              onkeydown="if(event.ctrlKey && event.keyCode === 13){searchItems();return false;}"></textarea>
                    <p class="panel-note">A file is included when its name or path contains any keyword.</p>
                </div>

                <h3 style="margin-top:16px;">Optional file filters</h3>
                <div class="search-filter-grid">
                    <label>Minimum size (MB)<input id="searchMinSize" type="number" min="0" step="any" placeholder="Any size" aria-label="Minimum file size in megabytes"></label>
                    <label>Maximum size (MB)<input id="searchMaxSize" type="number" min="0" step="any" placeholder="Any size" aria-label="Maximum file size in megabytes"></label>
                    <label>Extensions<input id="searchExtensions" placeholder="pdf, docx, jpg" aria-label="File extensions"></label>
                    <label>Modified after<input id="searchModifiedAfter" type="date" aria-label="Modified after date"></label>
                    <label>Modified before<input id="searchModifiedBefore" type="date" aria-label="Modified before date"></label>
                </div>

                <div style="margin-top:16px;">
                    <h3>Exclude from this search</h3>
                    <textarea id="searchExcluded" class="exclusion-list"
                              placeholder="One folder path or file/folder pattern per line">.safeq6
.ms-ad
*.iso
*.zip
*.pst</textarea>
                </div>

                <div class="inline-actions" style="margin-top:16px;">
                    <button class="success" onclick="searchItems()">
                        Search
                    </button>
                </div>

            </div>

            <div class="panel task-results">
                <div class="panel-heading"><h3>Search results</h3></div>
                <div class="progress" style="margin-top:8px;">
                    <div id="searchProgressbar" class="progressbar"></div>
                </div>
                <div class="progress-meta"><span id="searchProgressMessage">No search run</span><span id="searchMatchCount">0 matches</span><span id="searchFilesChecked">0 files checked</span><span id="searchElapsed">Elapsed 00:00</span><span id="searchProgressPercent">0%</span></div>
                <div class="scan-controls">
                    <button id="searchPauseButton" type="button" onclick="togglePauseOperation()" disabled>Pause</button>
                    <button type="button" onclick="cancelOperation()" disabled id="searchCancelButton">Cancel</button>
                </div>
                <div class="result-toolbar">
                    <input id="searchResultFilter" aria-label="Filter search results by name or path" placeholder="Filter results by name or path" onkeyup="renderSearchResults()">
                    <select id="searchResultSort" onchange="renderSearchResults()">
                        <option value="name">Sort by name</option>
                        <option value="path">Sort by path</option>
                        <option value="size">Sort by size</option>
                    </select>
                    <span id="searchResultSummary" class="result-summary">0 results</span>
                </div>
                <div class="inline-actions" style="margin-top:10px;">
                    <button type="button" onclick="selectVisibleSearchResults(true)">Select visible</button>
                    <button type="button" onclick="selectVisibleSearchResults(false)">Clear selection</button>
                    <button type="button" class="success" onclick="exportSearchResults()">Export results CSV</button>
                </div>
                <div class="table-wrap">
                <table class="result-table search-results-table">

                    <thead>
                    <tr>
                        <th class="select-column">Select</th>
                        <th class="name-column">Name</th>
                        <th>Path</th>
                        <th class="size-column">Size</th>
                    </tr>
                    </thead>

                    <tbody id="searchResults">

                    </tbody>

                </table>
                </div>
            </div>
            </div>

        </div>

        <!-- DUPLICATES -->

        <div id="duplicatesPage"
             class="page"
             style="display:none;">

            <div class="page-heading">
                <div>
                    <p class="eyebrow">Workspace</p>
                    <h1>Duplicates</h1>
                    <p>Preview duplicate candidates before choosing whether to remove them.</p>
                </div>
            </div>

            <div class="workspace-grid">
            <div class="panel task-controls">

                <h3>Scan criteria</h3>
                <p class="panel-note">The folder and exclusions below apply only to duplicate detection.</p>

                <div class="folder-row">
                    <input id="duplicatesRoot"
                           placeholder="Folder to scan for duplicates">
                    <button onclick="browseFolderFor('duplicatesRoot','Select Duplicate Folder')">Browse</button>
                </div>
                <select id="duplicatesRecentFolders" onchange="chooseRecentFolder('duplicatesRoot','duplicatesRecentFolders')" aria-label="Recent duplicate scan folders">
                    <option value="">Recent folders</option>
                </select>

                <h3 style="margin-top:18px;">Duplicate keywords</h3>
                <textarea id="duplicateSearchTerms" class="keyword-list"
                          placeholder="Optional: one or more terms; separate with commas, semicolons, or new lines"></textarea>
                <p class="panel-note">Matching files are scanned, reported, and considered for deletion; nonmatching duplicates are preserved.</p>

                <h3 style="margin-top:20px;">Exclude from duplicate scan</h3>
                <textarea id="duplicatesExcluded" class="exclusion-list"
                          placeholder="One folder path or file/folder pattern per line">.safeq6
.ms-ad
*.iso
*.zip
*.pst</textarea>

                <div class="inline-actions" style="margin-top:16px;">
                    <button class="success" onclick="runScan('duplicatesRoot')">Scan for duplicates</button>
                </div>

                <h3 style="margin-top:20px;">Scan profiles</h3>
                <p class="panel-note">Save reusable folders, exclusions, file filters, duplicate terms, and cleanup preferences.</p>
                <select id="scanProfileSelect" aria-label="Saved scan profile" onchange="applyScanProfile()">
                    <option value="">Choose a saved profile</option>
                </select>
                <div class="inline-actions">
                    <input id="scanProfileName" placeholder="Profile name" aria-label="Profile name">
                    <button type="button" onclick="saveScanProfile()">Save profile</button>
                    <button type="button" class="danger" onclick="deleteScanProfile()">Delete profile</button>
                </div>
            </div>

            <div class="panel task-results">
                <div class="panel-heading"><h3>Duplicate candidates</h3></div>

                <div class="progress" style="margin-top:16px;">
                    <div id="progressbar"
                         class="progressbar">
                    </div>
                </div>
                <div class="progress-meta"><span id="duplicateProgressMessage">No scan run</span><span id="duplicateCountStatus">0 duplicates</span><span id="duplicateFilesChecked">0 files checked</span><span id="duplicateElapsed">Elapsed 00:00</span><span id="duplicateProgressPercent">0%</span></div>
                <div class="scan-controls">
                    <button id="duplicatePauseButton" type="button" onclick="togglePauseOperation()" disabled>Pause</button>
                    <button id="duplicateCancelButton" type="button" onclick="cancelOperation()" disabled>Cancel</button>
                </div>
                <div class="result-toolbar">
                    <input id="duplicateResultFilter" aria-label="Filter duplicate groups by name or path" placeholder="Filter groups by name or path" onkeyup="handleDuplicateFilterChanged()">
                    <select id="duplicateResultSort" onchange="renderDuplicateResults()">
                        <option value="path">Sort by path</option>
                        <option value="size">Sort by size</option>
                    </select>
                    <span id="duplicateResultSummary" class="result-summary">0 groups</span>
                    <span id="duplicateSelectionSummary" class="selection-summary">0 selected; 0 total</span>
                </div>

                <div class="table-wrap">
                <table class="result-table">
                    <thead>
                    <tr>
                        <th>Keep<br><label class="duplicate-bulk-choice"><input id="duplicateKeepAll" type="checkbox" aria-label="Select all recommended keep copies" title="Use the recommended keep copy for every visible duplicate group" onchange="applyVisibleDuplicateKeepDefaults(this.checked)">Select all</label></th>
                        <th>Remove<br><label class="duplicate-bulk-choice"><input id="duplicateRemoveAll" type="checkbox" aria-label="Select all removable duplicate copies" title="Select or clear every removable copy in the visible duplicate groups" onchange="selectVisibleDuplicateRemovals(this.checked)">Select all</label></th>
                        <th>File name and path</th>
                        <th class="size-column">Size</th>
                        <th class="hash-column">SHA-256</th>
                    </tr>
                    </thead>
                    <tbody id="duplicateResults">
                    </tbody>
                </table>
                </div>

                <div class="inline-actions" style="margin-top:16px;">
                    <button class="success" onclick="runReports('duplicatesRoot')">Export CSV</button>
                    <select id="cleanupMethod" onchange="saveSettings();updateDuplicateCleanupPreview()">
                        <option value="recycle">Move to Recycle Bin</option>
                        <option value="quarantine">Move to quarantine</option>
                        <option value="permanent">Permanently delete</option>
                    </select>
                    <button id="deleteDuplicatesButton" class="danger" onclick="deleteSelected()" disabled>Remove selected files</button>
                </div>
                <p id="cleanupPreviewSummary" class="panel-note">Select duplicate copies to preview the estimated recovery.</p>
                <div class="inline-actions">
                    <label for="recycleBinScope">Empty Recycle Bin on</label>
                    <select id="recycleBinScope" aria-label="Recycle Bin drive scope" onchange="saveSettings();updateRecycleBinScopeSummary()">
                        <option value="scanDrive">Drive containing the duplicate scan folder</option>
                        <option value="allDrives">All drives</option>
                    </select>
                    <button id="emptyRecycleBinButton" type="button" class="danger" onclick="emptyRecycleBin()">Empty Recycle Bin</button>
                </div>
                <div class="inline-actions">
                    <span id="recycleBinScopeSummary" class="panel-note">Scope follows the drive containing the selected duplicate scan folder.</span>
                </div>
                <h3 style="margin-top:24px;">Quarantine recovery</h3>
                <p class="panel-note">Review quarantined copies and restore them to their original locations. Existing files are never overwritten.</p>
                <div class="inline-actions">
                    <button type="button" onclick="loadQuarantineBatches()">Refresh quarantine</button>
                    <select id="quarantineBatchSelect" onchange="showQuarantineBatch(this.value)" aria-label="Quarantine batch"></select>
                    <select id="restoreConflictMode" aria-label="Restore behavior when original file exists">
                        <option value="rename">Restore using a new name</option>
                        <option value="skip">Skip existing paths</option>
                    </select>
                    <button type="button" class="success" onclick="restoreSelectedQuarantine()">Restore selected</button>
                </div>
                <p id="quarantineSummary" class="panel-note">Quarantine has not been loaded.</p>
                <div class="table-wrap">
                    <table class="result-table">
                        <thead><tr><th>Select</th><th>Status</th><th>Original location</th><th>Quarantined copy</th><th>Size</th></tr></thead>
                        <tbody id="quarantineResults"></tbody>
                    </table>
                </div>
            </div>
            </div>

        </div>

        <!-- LARGE FILES -->
        <div id="largeFilesPage" class="page" style="display:none;">
            <div class="page-heading">
                <div>
                    <p class="eyebrow">Space recovery</p>
                    <h1>Large Files</h1>
                    <p>Find large files for review. Cloud-only placeholders are informational and linked files are flagged because removing them may not free disk space.</p>
                </div>
            </div>
            <div class="workspace-grid">
                <div class="panel task-controls">
                    <h3>Scan criteria</h3>
                    <div class="folder-row">
                        <input id="largeFilesRoot" placeholder="Folder to search for large files">
                        <button type="button" onclick="browseFolderFor('largeFilesRoot','Select Large File Folder')">Browse</button>
                    </div>
                    <div class="search-filter-grid">
                        <label>Minimum size (MB)<input id="largeFilesMinSize" type="number" min="0" step="any" value="100" aria-label="Minimum large-file size in megabytes"></label>
                        <label>Maximum size (MB, optional)<input id="largeFilesMaxSize" type="number" min="0" step="any" placeholder="No maximum" aria-label="Maximum large-file size in megabytes"></label>
                        <label>Exclude folders and patterns<textarea id="largeFilesExcluded" class="exclusion-list" placeholder="One folder path or file/folder pattern per line"></textarea></label>
                    </div>
                    <div class="inline-actions">
                        <button type="button" class="success" onclick="runLargeFileScan()">Find large files</button>
                    </div>
                    <h3 style="margin-top:20px;">Recovery method</h3>
                    <div class="inline-actions large-file-recovery-actions">
                        <select id="largeFileCleanupMethod" onchange="saveSettings()">
                            <option value="recycle">Move to Recycle Bin</option>
                            <option value="quarantine">Move to quarantine</option>
                            <option value="permanent">Permanently delete</option>
                        </select>
                        <button id="removeLargeFilesButton" type="button" class="danger" onclick="removeSelectedLargeFiles()" disabled>Remove selected files</button>
                    </div>
                    <p id="largeFileSelectionSummary" class="panel-note">0 selected; estimated reclaim 0 B.</p>
                </div>
                <div class="panel task-results">
                    <div class="panel-heading"><h3>Large files</h3></div>
                    <div class="progress" style="margin-top:8px;"><div id="largeFilesProgressbar" class="progressbar"></div></div>
                    <div class="progress-meta"><span id="largeFilesProgressMessage">No scan run</span><span id="largeFilesCount">0 files</span><span id="largeFilesChecked">0 files checked</span><span id="largeFilesElapsed">Elapsed 00:00</span><span id="largeFilesProgressPercent">0%</span></div>
                    <div class="scan-controls">
                        <button id="largeFilesPauseButton" type="button" onclick="togglePauseOperation()" disabled>Pause</button>
                        <button id="largeFilesCancelButton" type="button" onclick="cancelOperation()" disabled>Cancel</button>
                    </div>
                    <div class="result-toolbar">
                        <input id="largeFilesFilter" aria-label="Filter large-file results by name or path" placeholder="Filter files by name or path" onkeyup="renderLargeFileResults()">
                        <select id="largeFilesSort" onchange="renderLargeFileResults()">
                            <option value="size-desc">Largest first</option>
                            <option value="size-asc">Smallest first</option>
                            <option value="path">Sort by path</option>
                        </select>
                        <span id="largeFilesSummary" class="result-summary">0 files</span>
                    </div>
                    <div class="inline-actions">
                        <button type="button" onclick="selectVisibleLargeFiles(true)">Select visible</button>
                        <button type="button" onclick="selectVisibleLargeFiles(false)">Clear selection</button>
                    </div>
                    <div class="table-wrap">
                        <table class="result-table">
                            <thead><tr><th>Select</th><th>Name and path</th><th class="size-column">Size</th><th>Hard links</th><th>Storage status</th><th>Modified</th></tr></thead>
                            <tbody id="largeFilesResults"></tbody>
                        </table>
                    </div>
                    <p class="panel-note">Estimated reclaim excludes hard-linked files unless removing the last link is confirmed at cleanup. Available-space change is measured after cleanup and may be affected by other disk activity.</p>
                </div>
            </div>
        </div>

        <!-- REPORTS -->

        <div id="reportsPage"
             class="page"
             style="display:none;">

            <div class="page-heading">
                <div>
                    <p class="eyebrow">Records</p>
                    <h1>Reports</h1>
                    <p>Generate and review a CSV of duplicate candidates for a selected folder.</p>
                </div>
            </div>

            <div class="cards">
                <div class="card"><div class="title">Report candidates</div><div class="value" id="reportDuplicateCount">0</div><div class="metric-note">In the latest report</div></div>
                <div class="card"><div class="title">Potential recovery</div><div class="value" id="reportRecoverable">0 B</div><div class="metric-note">From listed duplicates</div></div>
                <div class="card"><div class="title">Report status</div><div class="value" id="reportStatus">Not run</div><div class="metric-note" id="reportGeneratedAt">No report in this session</div></div>
            </div>

            <div class="workspace-grid">
                <div class="panel task-controls">
                    <h3>Report source</h3>
                    <div class="folder-row">
                        <input id="reportsRoot" placeholder="Folder to generate report for">
                        <button onclick="browseFolderFor('reportsRoot','Select Report Folder')">Browse</button>
                    </div>
                    <div class="inline-actions" style="margin-top:16px;">
                        <button class="success" onclick="runReports('reportsRoot')">Generate CSV</button>
                        <button id="openReportButton" onclick="openReportFile()" disabled>Open CSV</button>
                    </div>
                    <h3 style="margin-top:20px;">Export destination</h3>
                    <p class="panel-note">Choose where generated CSV reports are saved. Leave blank to use the application Reports folder.</p>
                    <div class="folder-row">
                        <input id="reportsOutputFolder" placeholder="Optional report output folder">
                        <button onclick="browseFolderFor('reportsOutputFolder','Select Report Output Folder')">Browse</button>
                    </div>
                </div>

                <div class="panel task-results">
                    <div class="panel-heading"><h3>Report results</h3></div>
                    <div class="progress" style="margin-top:8px;"><div id="reportProgressbar" class="progressbar"></div></div>
                    <div class="progress-meta"><span id="reportProgressMessage">No report run</span><span id="reportProgressPercent">0%</span></div>
                    <p id="reportLocation" class="panel-note" style="margin-top:18px;">No report generated in this session.</p>
                    <div class="table-wrap"><table class="result-table"><thead><tr><th>Duplicate path</th><th class="size-column">Size</th><th class="hash-column">SHA-256</th></tr></thead><tbody id="reportResults"></tbody></table></div>
                </div>
            </div>

        </div>

        <!-- LOGS -->

        <div id="logsPage"
             class="page"
             style="display:none;">

            <div class="page-heading">
                <div>
                    <p class="eyebrow">Records</p>
                    <h1>Activity Log</h1>
                    <p>Review operation logs saved beside the application.</p>
                </div>
            </div>

            <div class="cards">
                <div class="card"><div class="title">Log files</div><div class="value" id="logFileCount">0</div><div class="metric-note">Available in selected folder</div></div>
                <div class="card"><div class="title">Most recent log</div><div class="value" id="latestLogName">None</div><div class="metric-note" id="latestLogDate">Load logs to inspect activity</div></div>
            </div>

            <div class="workspace-grid">
                <div class="panel task-controls">
                    <h3>Activity source</h3>
                    <div class="folder-row">
                        <input id="logsRoot" placeholder="Folder containing logs">
                        <button onclick="browseFolderFor('logsRoot','Select Log Folder')">Browse</button>
                    </div>
                    <div class="inline-actions" style="margin-top:16px;">
                        <button class="success" onclick="runLogAction('logsRoot')">Load logs</button>
                    </div>
                </div>

                <div class="panel task-results">
                    <div class="panel-heading"><h3>Log files</h3></div>
                    <div class="progress" style="margin-top:8px;"><div id="logsProgressbar" class="progressbar"></div></div>
                    <div class="progress-meta"><span id="logsProgressMessage">No log lookup run</span><span id="logsProgressPercent">0%</span></div>
                    <div class="table-wrap"><table class="result-table"><thead><tr><th>Log file</th><th class="time-column">Last modified</th><th class="action-column">Action</th></tr></thead><tbody id="logsResults"></tbody></table></div>
                    <h3 style="margin-top:18px;">Selected log contents: <span id="selectedLogName">No log selected</span></h3>
                    <pre id="selectedLogContent" class="log log-preview">Select a log file above to view its contents.</pre>
                    <h3 style="margin-top:18px;">Recent application activity</h3>
                    <div id="log" class="log">Ready...</div>
                </div>
            </div>

        </div>

    </div>

    <div id="statusText" class="statusbar">Ready</div>

</div>

<script>

function writeLog(msg)
{
    var targets = [
        document.getElementById("dashboardLog"),
        document.getElementById("log")
    ];

    for(var i = 0; i < targets.length; i++)
    {
        if(!targets[i]) continue;
        targets[i].innerHTML += "<div>" + escapeHtml(msg) + "</div>";
        targets[i].scrollTop = targets[i].scrollHeight;
    }

    appendOperationLog(msg);
}

function getApplicationLogDirectory()
{
    return (new ActiveXObject("WScript.Shell").ExpandEnvironmentStrings("%LOCALAPPDATA%")) + "\\DuplicateCleaner\\Logs";
}

function ensureApplicationLogDirectory()
{
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var appDirectory = (new ActiveXObject("WScript.Shell").ExpandEnvironmentStrings("%LOCALAPPDATA%")) + "\\DuplicateCleaner";
    var directory = getApplicationLogDirectory();

    if(!fso.FolderExists(appDirectory))
        fso.CreateFolder(appDirectory);
    if(!fso.FolderExists(directory))
        fso.CreateFolder(directory);

    return directory;
}

function ensureApplicationQuarantineDirectory()
{
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var appDirectory = (new ActiveXObject("WScript.Shell").ExpandEnvironmentStrings("%LOCALAPPDATA%")) + "\\DuplicateCleaner";
    var directory = appDirectory + "\\Quarantine";
    if(!fso.FolderExists(appDirectory))
        fso.CreateFolder(appDirectory);
    if(!fso.FolderExists(directory))
        fso.CreateFolder(directory);
    return directory;
}

function appendUtf8File(path, text)
{
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 2;
    stream.Charset = "utf-8";
    stream.Open();

    if(new ActiveXObject("Scripting.FileSystemObject").FileExists(path))
    {
        stream.LoadFromFile(path);
        stream.Position = stream.Size;
    }

    stream.WriteText(String(text) + "\r\n");
    stream.SaveToFile(path, 2);
    stream.Close();
}

function startOperationLog(mode, rootFolder, details)
{
    try
    {
        var directory = ensureApplicationLogDirectory();
        var now = new Date();
        var stamp = now.getFullYear() + padNumber(now.getMonth() + 1) + padNumber(now.getDate()) + "_" +
            padNumber(now.getHours()) + padNumber(now.getMinutes()) + padNumber(now.getSeconds()) + "_" + padNumber(now.getMilliseconds(), 3);
        currentOperationLogPath = new ActiveXObject("Scripting.FileSystemObject").BuildPath(directory, "DuplicateCleanup_" + mode + "_" + stamp + ".log");
        appendUtf8File(currentOperationLogPath, "Operation: " + mode);
        appendUtf8File(currentOperationLogPath, "Started: " + now.toLocaleString());
        appendUtf8File(currentOperationLogPath, "Folder: " + rootFolder);
        if(details)
            appendUtf8File(currentOperationLogPath, details);
        return true;
    }
    catch(e)
    {
        currentOperationLogPath = "";
        updateStatus("Unable to create operation log");
        return false;
    }
}

function appendOperationLog(message)
{
    if(!currentOperationLogPath) return;

    try
    {
        appendUtf8File(currentOperationLogPath, new Date().toLocaleTimeString() + "  " + message);
    }
    catch(e)
    {
        currentOperationLogPath = "";
        updateStatus("Operation log write failed");
    }
}

function logFailedOperation(mode, rootFolder, message, details)
{
    if(mode !== "Logs" && startOperationLog(mode, rootFolder || "", details || ""))
        appendOperationLog("ERROR: " + message);
}

function padNumber(value, length)
{
    var padded = String(value);
    while(padded.length < (length || 2)) padded = "0" + padded;
    return padded;
}

function escapeHtml(value)
{
    return String(value === null || value === undefined ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}

function formatBytes(value)
{
    var bytes = Number(value) || 0;
    if(bytes < 1024) return bytes + " B";
    if(bytes < 1048576) return (bytes / 1024).toFixed(1) + " KB";
    if(bytes < 1073741824) return (bytes / 1048576).toFixed(1) + " MB";
    return (bytes / 1073741824).toFixed(2) + " GB";
}

function setEmptyRow(targetId, columns, message)
{
    var target = document.getElementById(targetId);
    if(target)
        target.innerHTML = '<tr><td class="empty-state" colspan="' + columns + '">' + escapeHtml(message) + '</td></tr>';
}

function renderResultData(data)
{
    var rows = data.rows || [];
    if(!(rows instanceof Array)) rows = [rows];

    if(data.mode === "EmptyRecycleBin")
    {
        var recycleBinMessage = data.emptied ?
            "Recycle Bin emptied for " + (data.scope || "the selected scope") + ". Items were permanently deleted." :
            "Recycle Bin was not emptied.";
        updateStatus(recycleBinMessage);
        writeLog(recycleBinMessage);
        return;
    }

    if(data.mode === "LargeFiles")
    {
        latestLargeFiles = rows;
        largeFileSelectedPaths = {};
        setText("largeFilesCount", (data.resultCount || 0) + " files");
        renderLargeFileResults();
        var largeScanMessage = "Found " + (data.resultCount || 0) + " large files totaling " + formatBytes(data.totalBytes || 0) + ".";
        if(data.cloudPlaceholderCount)
            largeScanMessage += " " + data.cloudPlaceholderCount + " cloud placeholder(s) are informational only.";
        if(data.scanErrorCount)
            largeScanMessage += " " + data.scanErrorCount + " item(s) could not be checked; review the log.";
        setText("largeFilesProgressMessage", largeScanMessage);
        return;
    }

    if(data.mode === "Search")
    {
        latestSearchRows = rows;
        searchSelectedPaths = {};
        setText("searchMatchCount", (data.resultCount || rows.length) + " matches");
        renderSearchResults();
        return;
    }
    if(data.mode === "Scan")
    {
        latestScanData = data;
        setText("filesScanned", data.filesScanned || 0);
        setText("duplicatesFound", data.duplicateCount || 0);
        setText("duplicateCountStatus", (data.duplicateCount || 0) + " duplicates");
        setText("recoverSpace", formatBytes(data.recoverableBytes));
        setText("deletedFiles", data.deletedCount || 0);
        var scanErrors = Number(data.scanErrorCount) || 0;
        var scanSummary = data.duplicateCount ? "Analysis complete. Review the duplicate candidates before deletion." : "Analysis complete. No duplicate candidates were found.";
        if(scanErrors)
            scanSummary += " " + scanErrors + " item(s) could not be fully checked; review the operation log before cleanup.";
        if(data.cloudPlaceholderCount)
            scanSummary += " " + data.cloudPlaceholderCount + " cloud placeholder(s) were skipped to avoid fetching online-only content.";
        setText("scanAnalysisSummary", scanSummary);
        setText("scanAnalysisPath", data.rootFolder || "Selected folder");
        setText("scanAnalysisTime", data.completedAt || "Just completed");
        setText("scanAnalysisDuplicates", data.duplicateCount || 0);
        setText("scanAnalysisSpace", formatBytes(data.recoverableBytes));

        latestDuplicateGroups = data.groups || [];
        if(!(latestDuplicateGroups instanceof Array)) latestDuplicateGroups = [latestDuplicateGroups];
        duplicateSelectedPaths = {};
        var keepAllCheckbox = document.getElementById("duplicateKeepAll");
        if(keepAllCheckbox) keepAllCheckbox.checked = false;
        renderDuplicateResults();
        return;
    }

    if(data.mode === "Cleanup")
    {
        var removedPaths = data.removedPaths || [];
        if(!(removedPaths instanceof Array)) removedPaths = [removedPaths];
        if(data.cleanupKind === "largefiles")
        {
            for(var lp = latestLargeFiles.length - 1; lp >= 0; lp--)
            {
                for(var lr = 0; lr < removedPaths.length; lr++)
                    if(latestLargeFiles[lp].FullName === removedPaths[lr])
                    {
                        delete largeFileSelectedPaths[removedPaths[lr]];
                        latestLargeFiles.splice(lp, 1);
                        break;
                    }
            }
            renderLargeFileResults();
            var largeCleanupSummary = data.deletedCount + " file(s) processed; " + formatBytes(data.recoverableBytes || 0) + " removed from the selected folder. ";
            if(data.recoveryMode === "permanent")
                largeCleanupSummary += data.sourceVolumeSpaceChangeBytes === null || data.sourceVolumeSpaceChangeBytes === undefined ?
                    "Available-space change could not be measured." :
                    "Measured free-space change on the source volume: " + formatBytes(data.sourceVolumeSpaceChangeBytes) + ".";
            else if(data.recoveryMode === "recycle")
                largeCleanupSummary += "Space may not be available until that drive's Recycle Bin is emptied.";
            else
                largeCleanupSummary += "Quarantine may use storage on the same drive.";
            if(data.failedCount) largeCleanupSummary += " " + data.failedCount + " file(s) failed; see the operation log.";
            setText("largeFileSelectionSummary", largeCleanupSummary);
            return;
        }
        for(var g = latestDuplicateGroups.length - 1; g >= 0; g--)
        {
            var groupFiles = latestDuplicateGroups[g].files || [];
            for(var f = groupFiles.length - 1; f >= 0; f--)
            {
                for(var r = 0; r < removedPaths.length; r++)
                {
                    if(groupFiles[f].Path === removedPaths[r])
                    {
                        delete duplicateSelectedPaths[groupFiles[f].Path];
                        groupFiles.splice(f, 1);
                        break;
                    }
                }
            }
            if(groupFiles.length < 2)
                latestDuplicateGroups.splice(g, 1);
        }
        setText("deletedFiles", data.deletedCount || 0);
        var cleanupSummary = data.cancelled ? "Cleanup cancelled after processing " + (data.deletedCount || 0) + " selected file(s). " : "Cleanup complete. " + (data.deletedCount || 0) + " selected files processed. ";
        if(data.recoveryMode === "permanent")
            cleanupSummary += "Permanently deleted " + formatBytes(data.recoverableBytes || 0) + "; measured source-volume free-space change: " + (data.sourceVolumeSpaceChangeBytes === null || data.sourceVolumeSpaceChangeBytes === undefined ? "unavailable" : formatBytes(data.sourceVolumeSpaceChangeBytes)) + ".";
        else if(data.recoveryMode === "quarantine")
            cleanupSummary += formatBytes(data.recoverableBytes || 0) + " moved to quarantine: " + (data.quarantinePath || "location unavailable") + ". This may not free space if quarantine is on the same drive.";
        else
            cleanupSummary += formatBytes(data.recoverableBytes || 0) + " moved to the Recycle Bin. Space may not be available until it is emptied.";
        if(data.failedCount)
            cleanupSummary += " " + data.failedCount + " file(s) could not be moved; see the operation log.";
        setText("scanAnalysisSummary", cleanupSummary);
        var remainingDuplicates = renderDuplicateResults();
        setText("duplicateCountStatus", remainingDuplicates + " duplicates remaining");
        setText("duplicatesFound", remainingDuplicates);
        setText("scanAnalysisDuplicates", remainingDuplicates);
        if(latestScanData)
        {
            latestScanData.recoverableBytes = getDuplicateCandidateReclaimEstimate();
            setText("recoverSpace", formatBytes(latestScanData.recoverableBytes));
            setText("scanAnalysisSpace", formatBytes(latestScanData.recoverableBytes));
        }
        return;
    }

    if(data.mode === "Reports")
    {
        latestReportPath = data.reportPath || "";
        var openButton = document.getElementById("openReportButton");
        if(openButton) openButton.disabled = !latestReportPath;
        var reportErrors = Number(data.scanErrorCount) || 0;
        setText("reportLocation", "CSV saved to: " + (data.reportPath || "") + (reportErrors ? " " + reportErrors + " item(s) could not be checked; review the operation log." : ""));
        setText("reportDuplicateCount", data.duplicateCount || 0);
        setText("reportRecoverable", formatBytes(data.recoverableBytes));
        setText("reportStatus", reportErrors ? "Ready with warnings" : "Ready");
        setText("reportGeneratedAt", data.createdAt || "Generated this session");
        var reportRows = "";
        for(var k = 0; k < rows.length; k++)
        {
            reportRows += "<tr><td title=\"" + escapeHtml(rows[k].Path) + "\">" + escapeHtml(rows[k].Path) + "</td><td title=\"" + escapeHtml(rows[k].Length) + " bytes\">" + formatBytes(rows[k].Length) + "</td><td title=\"" + escapeHtml(rows[k].Hash) + "\">" + escapeHtml(rows[k].Hash) + "</td></tr>";
        }
        document.getElementById("reportResults").innerHTML = reportRows || '<tr><td class="empty-state" colspan="3">No duplicate candidates to report.</td></tr>';
        return;
    }

    if(data.mode === "Logs")
    {
        latestLogRows = rows;
        setText("logFileCount", rows.length);
        var newestLog = rows.length ? rows[0] : null;
        var newestName = newestLog ? (newestLog.FullName || "").split(/[\\/]/).pop() : "None";
        setText("latestLogName", newestName);
        setText("latestLogDate", newestLog ? newestLog.LastWriteTime : "No logs found in this folder");
        var logRows = "";
        for(var m = 0; m < rows.length; m++)
        {
            logRows += "<tr><td title=\"" + escapeHtml(rows[m].FullName) + "\">" + escapeHtml(rows[m].FullName) + "</td><td title=\"" + escapeHtml(rows[m].LastWriteTime) + "\">" + escapeHtml(rows[m].LastWriteTime) + "</td><td><button type=\"button\" onclick=\"viewLogFile(" + m + ")\">View</button> <button type=\"button\" onclick=\"openLogFile(" + m + ")\">Open</button></td></tr>";
        }
        document.getElementById("logsResults").innerHTML = logRows || '<tr><td class="empty-state" colspan="3">No log files found.</td></tr>';
        if(rows.length)
            viewLogFile(0);
        else
        {
            setText("selectedLogName", "No log selected");
            setText("selectedLogContent", "No operation logs were found in this folder.");
        }
    }

    if(data.mode === "ListQuarantine")
    {
        latestQuarantineRows = rows;
        quarantineSelectedPaths = {};
        renderQuarantineBatches(data.batches || []);
        return;
    }

    if(data.mode === "Restore")
    {
        var restoreSummary = "Restored " + (data.restoredCount || 0) + "; skipped " + (data.skippedCount || 0) + "; failed " + (data.failedCount || 0) + ".";
        if(data.cancelled) restoreSummary = "Restore cancelled. " + restoreSummary;
        setText("quarantineSummary", restoreSummary + " Refresh the list to update available entries.");
        var restoreRows = "";
        for(var restoreIndex = 0; restoreIndex < rows.length; restoreIndex++)
        {
            restoreRows += "<tr><td></td><td>" + escapeHtml(rows[restoreIndex].status) + "</td><td title=\"" + escapeHtml(rows[restoreIndex].destination) + "\">" + escapeHtml(rows[restoreIndex].destination) + "</td><td title=\"" + escapeHtml(rows[restoreIndex].path) + "\">" + escapeHtml(rows[restoreIndex].path) + "</td><td>" + escapeHtml(rows[restoreIndex].message) + "</td></tr>";
        }
        document.getElementById("quarantineResults").innerHTML = restoreRows || '<tr><td class="empty-state" colspan="5">No restore results.</td></tr>';
    }
}

function renderSearchResults()
{
    var target = document.getElementById("searchResults");
    if(!target) return;

    var rows = latestSearchRows.slice(0);
    var filterField = document.getElementById("searchResultFilter");
    var sortField = document.getElementById("searchResultSort");
    var filter = filterField ? (filterField.value || "").toLowerCase() : "";
    var sort = sortField ? sortField.value : "name";
    rows.sort(function(left, right){
        var a = sort === "size" ? Number(left.Length) || 0 : sort === "path" ? (left.FullName || "").toLowerCase() : ((left.FullName || "").split(/[\\/]/).pop() || "").toLowerCase();
        var b = sort === "size" ? Number(right.Length) || 0 : sort === "path" ? (right.FullName || "").toLowerCase() : ((right.FullName || "").split(/[\\/]/).pop() || "").toLowerCase();
        if(a < b) return -1;
        if(a > b) return 1;
        return 0;
    });

    var resultRows = "";
    var visibleCount = 0;
    for(var i = 0; i < rows.length; i++)
    {
        var searchRow = rows[i];
        var path = searchRow.FullName || "";
        var name = path.split(/[\\/]/).pop();
        if(filter && path.toLowerCase().indexOf(filter) < 0 && name.toLowerCase().indexOf(filter) < 0)
            continue;

        var originalIndex = latestSearchRows.indexOf ? latestSearchRows.indexOf(searchRow) : i;
        if(originalIndex < 0) originalIndex = i;
        var selected = searchSelectedPaths[path] ? " checked" : "";
        resultRows += "<tr><td><input class=\"keep-choice\" type=\"checkbox\" aria-label=\"Select " + escapeHtml(name) + "\" onchange=\"toggleSearchSelection(" + originalIndex + ",this.checked)\"" + selected + "></td><td title=\"" + escapeHtml(name) + "\"><a class=\"search-result-link\" href=\"#\" title=\"Open file\" onclick=\"openSearchTarget(" + originalIndex + ",false);return false;\">" + escapeHtml(name) + "</a></td><td title=\"" + escapeHtml(path) + "\"><a class=\"search-result-link path-link\" href=\"#\" title=\"Show file location in Explorer\" onclick=\"openSearchTarget(" + originalIndex + ",true);return false;\">" + escapeHtml(path) + "</a></td><td title=\"" + escapeHtml(searchRow.Length) + " bytes\">" + formatBytes(searchRow.Length) + "</td></tr>";
        visibleCount++;
    }
    target.innerHTML = resultRows || '<tr><td class="empty-state" colspan="4">No matching files. Try broadening your keywords or optional filters.</td></tr>';
    var selectedCount = 0;
    for(var key in searchSelectedPaths)
        if(Object.prototype.hasOwnProperty.call(searchSelectedPaths,key) && searchSelectedPaths[key]) selectedCount++;
    setText("searchResultSummary", selectedCount + " selected; " + visibleCount + " shown; " + latestSearchRows.length + " total");
}

function getVisibleSearchIndexes()
{
    var filterField = document.getElementById("searchResultFilter");
    var sortField = document.getElementById("searchResultSort");
    var filter = filterField ? (filterField.value || "").toLowerCase() : "";
    var sort = sortField ? sortField.value : "name";
    var indexes = [];
    for(var i = 0; i < latestSearchRows.length; i++)
    {
        var row = latestSearchRows[i];
        var path = row.FullName || "";
        var name = path.split(/[\\/]/).pop();
        if(!filter || path.toLowerCase().indexOf(filter) >= 0 || name.toLowerCase().indexOf(filter) >= 0)
            indexes.push(i);
    }
    indexes.sort(function(left, right){
        var a = latestSearchRows[left];
        var b = latestSearchRows[right];
        var first = sort === "size" ? Number(a.Length) || 0 : sort === "path" ? (a.FullName || "").toLowerCase() : ((a.FullName || "").split(/[\\/]/).pop() || "").toLowerCase();
        var second = sort === "size" ? Number(b.Length) || 0 : sort === "path" ? (b.FullName || "").toLowerCase() : ((b.FullName || "").split(/[\\/]/).pop() || "").toLowerCase();
        return first < second ? -1 : first > second ? 1 : 0;
    });
    return indexes;
}

function toggleSearchSelection(index, selected)
{
    var row = latestSearchRows[index];
    if(!row || !row.FullName) return;
    if(selected) searchSelectedPaths[row.FullName] = true;
    else delete searchSelectedPaths[row.FullName];
    renderSearchResults();
}

function selectVisibleSearchResults(selected)
{
    var indexes = getVisibleSearchIndexes();
    for(var i = 0; i < indexes.length; i++)
    {
        var path = latestSearchRows[indexes[i]].FullName;
        if(selected) searchSelectedPaths[path] = true;
        else delete searchSelectedPaths[path];
    }
    renderSearchResults();
}

function csvField(value)
{
    var text = String(value === null || value === undefined ? "" : value);
    if(/^[\t\r\n ]*[=+\-@]/.test(text))
        text = "'" + text;
    return "\"" + text.replace(/"/g, "\"\"") + "\"";
}

function exportSearchResults()
{
    var selectedIndexes = [];
    for(var i = 0; i < latestSearchRows.length; i++)
        if(searchSelectedPaths[latestSearchRows[i].FullName]) selectedIndexes.push(i);
    var indexes = selectedIndexes.length ? selectedIndexes : getVisibleSearchIndexes();
    if(!indexes.length)
    {
        updateStatus("No search results to export");
        return;
    }

    try
    {
        var directory = ensureApplicationLogDirectory();
        var now = new Date();
        var fileName = "SearchResults_" + now.getFullYear() + padNumber(now.getMonth()+1) + padNumber(now.getDate()) + "_" +
            padNumber(now.getHours()) + padNumber(now.getMinutes()) + padNumber(now.getSeconds()) + ".csv";
        var path = new ActiveXObject("Scripting.FileSystemObject").BuildPath(directory, fileName);
        var csv = "Name,Path,SizeBytes\r\n";
        for(var j = 0; j < indexes.length; j++)
        {
            var row = latestSearchRows[indexes[j]];
            csv += csvField((row.FullName || "").split(/[\\/]/).pop()) + "," +
                csvField(row.FullName || "") + "," + csvField(row.Length) + "\r\n";
        }
        writeUtf8File(path, csv);
        new ActiveXObject("WScript.Shell").Run('"' + path + '"', 1, false);
        updateStatus("Exported " + indexes.length + " search result(s)");
        writeLog("Search results CSV saved: " + path);
    }
    catch(e)
    {
        writeLog("ERROR exporting search results: " + e.message);
        updateStatus("Search results export failed");
    }
}

function renderDuplicateResults()
{
    var target = document.getElementById("duplicateResults");
    if(!target) return;

    var filterField = document.getElementById("duplicateResultFilter");
    var sortField = document.getElementById("duplicateResultSort");
    var filter = filterField ? (filterField.value || "").toLowerCase() : "";
    var sort = sortField ? sortField.value : "path";
    var groupIndexes = [];
    for(var i = 0; i < latestDuplicateGroups.length; i++)
        groupIndexes.push(i);

    groupIndexes.sort(function(leftIndex, rightIndex){
        var left = latestDuplicateGroups[leftIndex];
        var right = latestDuplicateGroups[rightIndex];
        var leftFile = left.files && left.files.length ? left.files[0] : {};
        var rightFile = right.files && right.files.length ? right.files[0] : {};
        var a = sort === "size" ? Number(leftFile.Length) || 0 : (leftFile.Path || "").toLowerCase();
        var b = sort === "size" ? Number(rightFile.Length) || 0 : (rightFile.Path || "").toLowerCase();
        return a < b ? -1 : a > b ? 1 : 0;
    });

    var rows = "";
    var visibleGroups = 0;
    var totalCandidates = 0;
    var selectedCount = 0;
    var visibleCandidates = 0;
    var visibleSelectedCount = 0;
    for(var g = 0; g < latestDuplicateGroups.length; g++)
    {
        var group = latestDuplicateGroups[g];
        var files = group.files || [];
        for(var c = 0; c < files.length; c++)
        {
            if(files[c].Path !== group.keepPath)
            {
                totalCandidates++;
                if(duplicateSelectedPaths[files[c].Path]) selectedCount++;
            }
        }
    }

    for(var n = 0; n < groupIndexes.length; n++)
    {
        var groupIndex = groupIndexes[n];
        var currentGroup = latestDuplicateGroups[groupIndex];
        var members = currentGroup.files || [];
        if(!duplicateGroupMatchesFilter(currentGroup, filter)) continue;

        visibleGroups++;
        var keepExplanation = currentGroup.keepPath === currentGroup.defaultKeepPath ?
            (currentGroup.keepReason || "Default keep: fewest subfolders from the scan root, then shortest relative path.") :
            "Keep copy chosen by you.";
        rows += "<tr class=\"group-heading\"><td colspan=\"5\">Duplicate set " + (visibleGroups) + " &mdash; " + members.length + " identical files. " + escapeHtml(keepExplanation) + "</td></tr>";
        for(var f = 0; f < members.length; f++)
        {
            var member = members[f];
            var isKeeper = member.Path === currentGroup.keepPath;
            var path = member.Path || "";
            var name = path.split(/[\\/]/).pop();
            var keepReason = isKeeper ? "<span class=\"keep-label\">Current keep copy</span>" : "";
            var checked = duplicateSelectedPaths[path] ? " checked" : "";
            var memberStorageNote = "";
            if(Number(member.HardLinkCount) > 1)
                memberStorageNote = " <span class=\"keep-label\">Hard linked (" + Number(member.HardLinkCount) + " links); may not free space</span>";
            else if(member.HardLinkCount === null || member.HardLinkCount === undefined)
                memberStorageNote = " <span class=\"keep-label\">Link count unavailable</span>";
            if(!isKeeper)
            {
                visibleCandidates++;
                if(duplicateSelectedPaths[path]) visibleSelectedCount++;
            }
            rows += "<tr><td><label><input class=\"keep-choice\" type=\"radio\" name=\"keepGroup" + groupIndex + "\"" + (isKeeper ? " checked" : "") + " onclick=\"chooseKeepCopy(" + groupIndex + "," + f + ")\">Keep</label> " + keepReason + "</td><td><input class=\"remove-choice\" type=\"checkbox\"" + (isKeeper ? " disabled" : "") + checked + " onchange=\"toggleDuplicateSelection(" + groupIndex + "," + f + ",this.checked)\">" + (isKeeper ? "—" : "Remove") + memberStorageNote + "</td><td title=\"" + escapeHtml(path) + "\"><strong>" + escapeHtml(name) + "</strong><br><span class=\"search-result-link path-link\">" + escapeHtml(path) + "</span></td><td title=\"" + escapeHtml(member.Length) + " bytes\">" + formatBytes(member.Length) + "</td><td title=\"" + escapeHtml(currentGroup.hash || member.Hash) + "\">" + escapeHtml(currentGroup.hash || member.Hash || "") + "</td></tr>";
        }
    }
    target.innerHTML = rows || '<tr><td class="empty-state" colspan="5">No duplicate groups match this filter.</td></tr>';
    setText("duplicateResultSummary", visibleGroups + " groups shown; " + latestDuplicateGroups.length + " total");
    setText("duplicateSelectionSummary", selectedCount + " selected; " + totalCandidates + " removable copies");
    var removeAllCheckbox = document.getElementById("duplicateRemoveAll");
    if(removeAllCheckbox)
    {
        removeAllCheckbox.checked = visibleCandidates > 0 && visibleSelectedCount === visibleCandidates;
        removeAllCheckbox.indeterminate = visibleSelectedCount > 0 && visibleSelectedCount < visibleCandidates;
        removeAllCheckbox.disabled = visibleCandidates === 0;
    }
    var deleteButton = document.getElementById("deleteDuplicatesButton");
    if(deleteButton) deleteButton.disabled = selectedCount === 0 || !!progressPollTimer;
    updateDuplicateCleanupPreview();
    return totalCandidates;
}

function handleDuplicateFilterChanged()
{
    var keepAllCheckbox = document.getElementById("duplicateKeepAll");
    if(keepAllCheckbox) keepAllCheckbox.checked = false;
    renderDuplicateResults();
}

function duplicateGroupMatchesFilter(group, filter)
{
    if(!filter) return true;
    var members = group && group.files ? group.files : [];
    for(var i = 0; i < members.length; i++)
        if((members[i].Path || "").toLowerCase().indexOf(filter) >= 0) return true;
    return false;
}

function getDuplicateResultFilter()
{
    var filterField = document.getElementById("duplicateResultFilter");
    return filterField ? (filterField.value || "").toLowerCase() : "";
}

function applyVisibleDuplicateKeepDefaults(selected)
{
    if(!selected) return;
    var filter = getDuplicateResultFilter();
    var updated = 0;
    for(var g = 0; g < latestDuplicateGroups.length; g++)
    {
        var group = latestDuplicateGroups[g];
        if(!duplicateGroupMatchesFilter(group, filter)) continue;
        var files = group.files || [];
        var keepPath = group.defaultKeepPath || "";
        var hasRecommendedCopy = false;
        for(var f = 0; f < files.length; f++)
            if(files[f].Path === keepPath) hasRecommendedCopy = true;
        if(!hasRecommendedCopy) continue;
        group.keepPath = keepPath;
        delete duplicateSelectedPaths[keepPath];
        updated++;
    }
    renderDuplicateResults();
    updateStatus("Applied recommended keep copy to " + updated + " visible duplicate group(s)");
}

function selectVisibleDuplicateRemovals(selected)
{
    var filter = getDuplicateResultFilter();
    var updated = 0;
    for(var g = 0; g < latestDuplicateGroups.length; g++)
    {
        var group = latestDuplicateGroups[g];
        if(!duplicateGroupMatchesFilter(group, filter)) continue;
        var files = group.files || [];
        for(var f = 0; f < files.length; f++)
        {
            var path = files[f].Path;
            if(path === group.keepPath) continue;
            if(selected) duplicateSelectedPaths[path] = true;
            else delete duplicateSelectedPaths[path];
            updated++;
        }
    }
    renderDuplicateResults();
    updateStatus((selected ? "Selected " : "Cleared ") + updated + " removable copy/copies in visible duplicate groups");
}

function chooseKeepCopy(groupIndex, fileIndex)
{
    var group = latestDuplicateGroups[groupIndex];
    if(!group || !group.files || !group.files[fileIndex]) return;
    group.keepPath = group.files[fileIndex].Path;
    delete duplicateSelectedPaths[group.keepPath];
    var keepAllCheckbox = document.getElementById("duplicateKeepAll");
    if(keepAllCheckbox) keepAllCheckbox.checked = false;
    renderDuplicateResults();
}

function toggleDuplicateSelection(groupIndex, fileIndex, selected)
{
    var group = latestDuplicateGroups[groupIndex];
    var file = group && group.files ? group.files[fileIndex] : null;
    if(!file || file.Path === group.keepPath) return;
    if(selected) duplicateSelectedPaths[file.Path] = true;
    else delete duplicateSelectedPaths[file.Path];
    renderDuplicateResults();
}

function getSelectedDuplicateFiles()
{
    var selected = [];
    for(var g = 0; g < latestDuplicateGroups.length; g++)
    {
        var group = latestDuplicateGroups[g];
        var files = group.files || [];
        for(var f = 0; f < files.length; f++)
        {
            var file = files[f];
            if(duplicateSelectedPaths[file.Path] && file.Path !== group.keepPath)
                selected.push({
                    Path:file.Path,
                    Hash:group.hash || file.Hash,
                    KeepPath:group.keepPath,
                    Length:Number(file.Length) || 0,
                    HardLinkCount:file.HardLinkCount
                });
        }
    }
    return selected;
}

function getDuplicateCandidateReclaimEstimate()
{
    var total = 0;
    for(var g = 0; g < latestDuplicateGroups.length; g++)
    {
        var group = latestDuplicateGroups[g];
        var files = group.files || [];
        for(var f = 0; f < files.length; f++)
            if(files[f].Path !== group.keepPath && files[f].HardLinkCount === 1)
                total += Number(files[f].Length) || 0;
    }
    return total;
}

function updateDuplicateCleanupPreview()
{
    var selected = getSelectedDuplicateFiles();
    var totalBytes = 0;
    var confidentlyReclaimableBytes = 0;
    var linkedCount = 0;
    var keepPaths = [];
    for(var i = 0; i < selected.length; i++)
    {
        totalBytes += selected[i].Length;
        if(selected[i].HardLinkCount === 1) confidentlyReclaimableBytes += selected[i].Length;
        else if(Number(selected[i].HardLinkCount) > 1) linkedCount++;
        if(keepPaths.indexOf(selected[i].KeepPath) < 0) keepPaths.push(selected[i].KeepPath);
    }
    var summary = selected.length + " selected (" + formatBytes(totalBytes) + " data size); estimated space recoverable by permanent deletion " + formatBytes(confidentlyReclaimableBytes) + ".";
    if(linkedCount) summary += " " + linkedCount + " hard-linked file(s) may not free space.";
    var methodField = document.getElementById("cleanupMethod");
    var method = methodField ? methodField.value : "recycle";
    if(method === "recycle") summary += " Recycle Bin contents continue using space until emptied.";
    else if(method === "quarantine") summary += " Quarantine may use space on the same drive.";
    else summary += " Permanent deletion is irreversible.";
    setText("cleanupPreviewSummary", summary);
}

function largeFilePhysicalReclaimEstimate(selected)
{
    var bytes = 0;
    var linked = 0;
    var unknown = 0;
    for(var i = 0; i < selected.length; i++)
    {
        var linkCount = selected[i].HardLinkCount;
        if(linkCount === 1) bytes += Number(selected[i].Length) || 0;
        else if(Number(linkCount) > 1) linked++;
        else unknown++;
    }
    return { bytes:bytes, linked:linked, unknown:unknown };
}

function selectVisibleLargeFiles(selected)
{
    var filterField = document.getElementById("largeFilesFilter");
    var filter = filterField ? (filterField.value || "").toLowerCase() : "";
    var changed = 0;
    for(var i = 0; i < latestLargeFiles.length; i++)
    {
        var file = latestLargeFiles[i];
        if(!file.EligibleForCleanup || (filter && (file.FullName || "").toLowerCase().indexOf(filter) < 0)) continue;
        if(selected) largeFileSelectedPaths[file.FullName] = true;
        else delete largeFileSelectedPaths[file.FullName];
        changed++;
    }
    renderLargeFileResults();
    updateStatus((selected ? "Selected " : "Cleared ") + changed + " visible large file(s)");
}

function renderLargeFileResults()
{
    var target = document.getElementById("largeFilesResults");
    if(!target) return;
    var filterField = document.getElementById("largeFilesFilter");
    var sortField = document.getElementById("largeFilesSort");
    var filter = filterField ? (filterField.value || "").toLowerCase() : "";
    var sort = sortField ? sortField.value : "size-desc";
    var visible = [];
    var selectedRows = [];
    for(var i = 0; i < latestLargeFiles.length; i++)
    {
        var item = latestLargeFiles[i];
        if(largeFileSelectedPaths[item.FullName]) selectedRows.push(item);
        var path = item.FullName || "";
        if(!filter || path.toLowerCase().indexOf(filter) >= 0) visible.push(i);
    }
    visible.sort(function(a,b){
        var first = latestLargeFiles[a];
        var second = latestLargeFiles[b];
        if(sort === "path")
        {
            var left = (first.FullName || "").toLowerCase();
            var right = (second.FullName || "").toLowerCase();
            return left < right ? -1 : left > right ? 1 : 0;
        }
        var sizeDiff = (Number(first.Length) || 0) - (Number(second.Length) || 0);
        return sort === "size-asc" ? sizeDiff : -sizeDiff;
    });
    var rows = "";
    for(var r = 0; r < visible.length; r++)
    {
        var originalIndex = visible[r];
        var file = latestLargeFiles[originalIndex];
        var path = file.FullName || "";
        var name = path.split(/[\\/]/).pop();
        var status = file.CloudPlaceholder ? "Cloud placeholder — not removable" :
            file.ReparsePoint ? "Linked/reparse point — not removable" :
            Number(file.HardLinkCount) > 1 ? "Hard linked; may not free space" :
            file.HardLinkCount === null || file.HardLinkCount === undefined ? "Link count unavailable" : "Local file";
        var checkbox = "<input class=\"remove-choice\" type=\"checkbox\" aria-label=\"Select " + escapeHtml(name) + "\"";
        if(!file.EligibleForCleanup) checkbox += " disabled";
        if(largeFileSelectedPaths[path]) checkbox += " checked";
        checkbox += " onchange=\"toggleLargeFileSelection(" + originalIndex + ",this.checked)\">";
        rows += "<tr><td>" + checkbox + "</td><td title=\"" + escapeHtml(path) + "\"><strong>" + escapeHtml(name) + "</strong><br><span class=\"search-result-link path-link\">" + escapeHtml(path) + "</span></td><td>" + formatBytes(file.Length) + "</td><td>" + escapeHtml(file.HardLinkCount === null || file.HardLinkCount === undefined ? "Unknown" : file.HardLinkCount) + "</td><td>" + escapeHtml(status) + "</td><td>" + escapeHtml(file.LastWriteTime || "") + "</td></tr>";
    }
    target.innerHTML = rows || '<tr><td class="empty-state" colspan="6">No large files match the current filter.</td></tr>';
    var estimate = largeFilePhysicalReclaimEstimate(selectedRows);
    var estimateMessage = selectedRows.length + " selected; estimated space recoverable by permanent deletion " + formatBytes(estimate.bytes) + ".";
    if(estimate.linked) estimateMessage += " " + estimate.linked + " hard-linked file(s) may not reclaim space.";
    if(estimate.unknown) estimateMessage += " " + estimate.unknown + " file(s) have unknown link counts and are excluded from the estimate.";
    setText("largeFileSelectionSummary", estimateMessage);
    setText("largeFilesSummary", visible.length + " shown; " + latestLargeFiles.length + " total");
    setText("largeFilesCount", latestLargeFiles.length + " files");
    var removeButton = document.getElementById("removeLargeFilesButton");
    if(removeButton) removeButton.disabled = selectedRows.length === 0 || !!progressPollTimer;
}

function toggleLargeFileSelection(fileIndex, selected)
{
    var file = latestLargeFiles[fileIndex];
    if(!file || !file.EligibleForCleanup) return;
    if(selected) largeFileSelectedPaths[file.FullName] = true;
    else delete largeFileSelectedPaths[file.FullName];
    renderLargeFileResults();
}

function runLargeFileScan()
{
    if(progressPollTimer)
    {
        updateStatus("Wait for the current operation to finish");
        return;
    }
    var root = getFolderValue("largeFilesRoot");
    if(!root || !root.trim() || !folderExists(root))
    {
        updateStatus("Choose an existing folder for the large-file scan");
        return;
    }
    var minField = document.getElementById("largeFilesMinSize");
    var maxField = document.getElementById("largeFilesMaxSize");
    var minMb = minField && minField.value !== "" ? Number(minField.value) : 100;
    var maxMb = maxField && maxField.value !== "" ? Number(maxField.value) : -1;
    if(!isFinite(minMb) || minMb < 0 || !isFinite(maxMb) || maxMb < -1 || (maxMb >= 0 && minMb > maxMb))
    {
        updateStatus("Enter a valid large-file size range");
        return;
    }
    var minBytes = Math.ceil(minMb * 1048576);
    var maxBytes = maxMb < 0 ? -1 : Math.floor(maxMb * 1048576);
    if(minBytes > 9007199254740991 || maxBytes > 9007199254740991)
    {
        updateStatus("Large-file size filters must be 8 PiB or less");
        return;
    }
    latestLargeFiles = [];
    largeFileSelectedPaths = {};
    setEmptyRow("largeFilesResults", 6, "Scanning for large files...");
    setText("largeFilesSummary", "0 files");
    saveSettings();
    runPowerShellCommand("LargeFiles", {
        rootFolder:root,
        excludedFolders:getExclusionValue("largeFilesExcluded"),
        searchMinBytes:minBytes,
        searchMaxBytes:maxBytes
    });
}

function removeSelectedLargeFiles()
{
    var selected = [];
    for(var i = 0; i < latestLargeFiles.length; i++)
    {
        var file = latestLargeFiles[i];
        if(largeFileSelectedPaths[file.FullName] && file.EligibleForCleanup)
            selected.push({ Path:file.FullName, Length:Number(file.Length), LastWriteTime:file.LastWriteTime, HardLinkCount:file.HardLinkCount });
    }
    if(!selected.length)
    {
        updateStatus("Select removable large files first");
        return;
    }
    var methodField = document.getElementById("largeFileCleanupMethod");
    var recoveryMode = methodField ? methodField.value : "recycle";
    var estimate = largeFilePhysicalReclaimEstimate(selected);
    var destination = recoveryMode === "permanent" ? "permanently delete" : recoveryMode === "quarantine" ? "move into quarantine" : "move to the Recycle Bin";
    var totalBytes = 0;
    for(var b = 0; b < selected.length; b++) totalBytes += Number(selected[b].Length) || 0;
    var preview = "Process " + selected.length + " file(s) with total data size " + formatBytes(totalBytes) + ".\r\nEstimated space recoverable by permanent deletion: " + formatBytes(estimate.bytes) + ".\r\nAction: " + destination + ".";
    if(estimate.linked) preview += "\r\n" + estimate.linked + " hard-linked file(s) may not release their storage.";
    if(!confirm(preview + "\r\n\r\nContinue?")) return;
    if(recoveryMode === "permanent")
    {
        var acknowledgement = prompt("Permanent deletion cannot be undone. Type DELETE to confirm.");
        if(acknowledgement !== "DELETE")
        {
            updateStatus("Permanent deletion cancelled");
            return;
        }
    }
    runPowerShellCommand("DeleteSelected", {
        rootFolder:getFolderValue("largeFilesRoot"),
        selectedFilesJson:JSON.stringify(selected),
        recoveryMode:recoveryMode,
        cleanupKind:"largefiles"
    });
}

function setText(elementId, value)
{
    var element = document.getElementById(elementId);
    if(element)
        element.innerText = value;
}

function openLogFile(index)
{
    if(!latestLogRows || !latestLogRows[index]) return;
    try
    {
        new ActiveXObject("WScript.Shell").Run('notepad.exe "' + latestLogRows[index].FullName + '"', 1, false);
    }
    catch(e)
    {
        writeLog("ERROR opening log: " + e.message);
    }
}

function viewLogFile(index)
{
    if(!latestLogRows || !latestLogRows[index]) return;

    try
    {
        var content = readUtf8File(latestLogRows[index].FullName);
        setText("selectedLogName", latestLogRows[index].FullName);
        setText("selectedLogContent", content || "This log file is empty.");
    }
    catch(e)
    {
        setText("selectedLogName", "Unable to read log");
        setText("selectedLogContent", e.message);
        writeLog("ERROR reading log: " + e.message);
    }
}

function openReportFile()
{
    if(!latestReportPath) return;
    try
    {
        new ActiveXObject("WScript.Shell").Run('"' + latestReportPath + '"', 1, false);
    }
    catch(e)
    {
        writeLog("ERROR opening report: " + e.message);
    }
}

function openSearchTarget(index, showLocation)
{
    if(!latestSearchRows || !latestSearchRows[index] || !latestSearchRows[index].FullName)
        return;

    var path = latestSearchRows[index].FullName;
    var command = showLocation ? 'explorer.exe /select,"' + path + '"' : '"' + path + '"';

    try
    {
        var shell = new ActiveXObject("WScript.Shell");
        var processId = shell.Run(command, showLocation ? 3 : 1, false);
        if(processId)
            shell.AppActivate(processId);
    }
    catch(e)
    {
        writeLog("ERROR opening search result: " + e.message);
        updateStatus("Unable to open search result");
    }
}

function updateStatus(text)
{
    var status =
        document.getElementById(
            "statusText"
        );

    if(status)
    {
        status.innerText = text;
    }
}

function browseFolderFor(targetId, title)
{
    try
    {
        var shell =
            new ActiveXObject(
                "Shell.Application"
            );

        var folder =
            shell.BrowseForFolder(
                0,
                title || "Select Folder",
                65
            );

        if(folder)
        {
            var selectedPath = folder.Self.Path;
            var fileSystem = new ActiveXObject("Scripting.FileSystemObject");

            if(!selectedPath || !fileSystem.FolderExists(selectedPath))
            {
                writeLog("ERROR: Select a filesystem folder, not a Windows Library or virtual location.");
                updateStatus("Choose a valid folder");
                return;
            }

            document.getElementById(targetId).value = selectedPath;

            writeLog(
                "Folder selected: " +
                selectedPath
            );
        }
    }
    catch(e)
    {
        writeLog(
            "ERROR: " + e.message
        );
    }
}

function getFolderValue(targetId)
{
    var field =
        document.getElementById(
            targetId
        );

    if(!field)
        return "";

    return field.value || "";
}

function folderExists(path)
{
    try
    {
        return new ActiveXObject("Scripting.FileSystemObject").FolderExists(path);
    }
    catch(e)
    {
        return false;
    }
}

function getExclusionValue(sourceId)
{
    var field = document.getElementById(sourceId || "duplicatesExcluded");
    return field ? (field.value || "").replace(/[\r\n]+/g, ";") : "";
}

function getKeywordValue(targetId)
{
    var field = document.getElementById(targetId);
    if(!field) return "";

    var terms = (field.value || "").split(/[,;\r\n]+/);
    var normalized = [];
    for(var i = 0; i < terms.length; i++)
    {
        var term = terms[i].replace(/^\s+|\s+$/g, "");
        if(term) normalized.push(term);
    }
    return normalized.join(";");
}

function getSearchFilterOptions()
{
    var minField = document.getElementById("searchMinSize");
    var maxField = document.getElementById("searchMaxSize");
    var minMb = minField && minField.value !== "" ? Number(minField.value) : -1;
    var maxMb = maxField && maxField.value !== "" ? Number(maxField.value) : -1;
    if(!isFinite(minMb) || !isFinite(maxMb) || minMb < 0 && minMb !== -1 || maxMb < 0 && maxMb !== -1 || (minMb >= 0 && maxMb >= 0 && minMb > maxMb))
        throw new Error("Enter a valid minimum and maximum file size in MB.");

    var extensionsField = document.getElementById("searchExtensions");
    var afterField = document.getElementById("searchModifiedAfter");
    var beforeField = document.getElementById("searchModifiedBefore");
    var after = afterField ? afterField.value : "";
    var before = beforeField ? beforeField.value : "";
    if(after && before && after > before)
        throw new Error("The Modified after date cannot be later than Modified before.");

    var minBytes = minMb < 0 ? -1 : Math.ceil(minMb * 1048576);
    var maxBytes = maxMb < 0 ? -1 : Math.floor(maxMb * 1048576);
    if(minBytes > 9007199254740991 || maxBytes > 9007199254740991)
        throw new Error("File-size filters must be 8 PiB or less.");

    return {
        searchMinBytes: minBytes,
        searchMaxBytes: maxBytes,
        searchExtensions: extensionsField ? getKeywordValue("searchExtensions").replace(/(^|;)\s*\./g, "$1") : "",
        searchModifiedAfter: after,
        searchModifiedBefore: before
    };
}

function runPowerShellCommand(mode, options)
{
    if(progressPollTimer)
    {
        writeLog("An operation is already running. Wait for it to finish before starting another.");
        updateStatus("Operation already running");
        return;
    }

    var rootFolder =
        options.rootFolder ||
        "";

    if(mode === "ListQuarantine" || mode === "RestoreSelected")
    {
        try { rootFolder = ensureApplicationQuarantineDirectory(); }
        catch(e)
        {
            writeLog("ERROR accessing application quarantine: " + e.message);
            updateStatus("Quarantine unavailable");
            return;
        }
    }
    if(mode !== "EmptyRecycleBin" && (!rootFolder || !rootFolder.trim()))
    {
        logFailedOperation(mode, "", "A folder path is required.");
        writeLog("ERROR: Please provide a valid folder path.");
        updateStatus("Folder required");
        return;
    }

    if(mode !== "EmptyRecycleBin" && !folderExists(rootFolder))
    {
        var folderFailure = "Folder not found: " + rootFolder;
        logFailedOperation(mode, rootFolder, folderFailure);
        renderOperationFailure(mode === "Search" ? "search" : mode === "Reports" ? "reports" : mode === "Logs" ? "logs" : "duplicates", folderFailure);
        writeLog("ERROR: " + folderFailure);
        updateStatus("Folder not found");
        return;
    }

    var exclusionRules = typeof options.excludedFolders === "string" ?
        options.excludedFolders : getExclusionValue("duplicatesExcluded");
    var operationName = options.deleteDuplicates ? "Delete" : mode;
    var logDetails = "";
    if(options.searchPattern)
        logDetails += "Search term: " + options.searchPattern + "\r\n";
    if(exclusionRules)
        logDetails += "Exclusions: " + exclusionRules.replace(/[;]+/g, ", ") + "\r\n";

    if(mode === "Logs")
        currentOperationLogPath = "";
    else if(!startOperationLog(operationName, rootFolder, logDetails))
    {
        writeLog("ERROR: Could not create an operation log in the logs folder.");
        return;
    }

    clearProgressFile();
    clearResultFile();
    clearControlFile();
    clearSelectedFilesFile();
    if(options.selectedFilesJson)
    {
        try
        {
            writeUtf8File(selectedFilesFilePath, options.selectedFilesJson);
        }
        catch(e)
        {
            writeLog("ERROR preparing selected files for cleanup: " + e.message);
            updateStatus("Cleanup could not start");
            return;
        }
    }
    var progressTarget = mode === "Search" ? "search" :
        mode === "Reports" ? "reports" :
        mode === "Logs" ? "logs" :
        mode === "LargeFiles" ? "largefiles" :
        mode === "DeleteSelected" && options.cleanupKind === "largefiles" ? "cleanupLarge" :
        (mode === "DeleteSelected" || mode === "EmptyRecycleBin") ? "cleanup" : "duplicates";
    setProgressTarget(progressTarget);
    updateStatus(mode + " running");
    writeLog("Running: " + mode + " for " + rootFolder);

    try
    {
        var command = createEmbeddedPowerShellCommand({
            rootFolder: rootFolder,
            mode: mode || "Scan",
            searchPattern: options.searchPattern || "",
            excludedFolders: exclusionRules,
            selectedFilesJson: options.selectedFilesJson || "",
            recoveryMode: options.recoveryMode || "",
            cleanupKind: options.cleanupKind || "duplicate",
            recycleBinRoot: options.recycleBinRoot || "",
            searchMinBytes: options.searchMinBytes || 0,
            searchMaxBytes: options.searchMaxBytes || 0,
            searchExtensions: options.searchExtensions || "",
            searchModifiedAfter: options.searchModifiedAfter || "",
            searchModifiedBefore: options.searchModifiedBefore || "",
            reportDirectory: options.reportDirectory || ""
        });
        var shell = new ActiveXObject("WScript.Shell");
        shell.Run(command, 0, false);
        startProgressPolling();
    }
    catch(e)
    {
        stopProgressPolling();
        operationPaused = false;
        setOperationControlButtons(false);
        var launchError = describeScriptError(e);
        writeLog("ERROR launching PowerShell: " + launchError);
        updateStatus("Operation could not start: " + launchError);
    }
}

