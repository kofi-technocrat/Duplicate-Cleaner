function quotePowerShellString(value)
{
    return "'" + String(value === null || value === undefined ? "" : value).replace(/'/g, "''") + "'";
}

function describeScriptError(error)
{
    if(error)
    {
        if(error.message) return error.message;
        if(error.description) return error.description;
        var text = String(error);
        if(text && text !== "[object Object]") return text;
    }
    return "Unknown scripting or COM error.";
}

function encodePowerShellCommand(command)
{
    var binary = "";
    var chunkSize = 2048;

    for(var start = 0; start < command.length; start += chunkSize)
    {
        var end = Math.min(start + chunkSize, command.length);
        var chunk = "";
        for(var i = start; i < end; i++)
        {
            var code = command.charCodeAt(i);
            chunk += String.fromCharCode(code & 255, code >> 8);
        }
        binary += chunk;
    }

    return window.btoa(binary);
}

function createEmbeddedPowerShellCommand(options)
{
    writeUtf8File(enginePayloadFilePath, embeddedEngineBase64);
    var wrapper =
        "$ErrorActionPreference='Stop';" +
        "$payload=[System.IO.File]::ReadAllText(" + quotePowerShellString(enginePayloadFilePath) + ");" +
        "$compressedBytes=[Convert]::FromBase64String($payload);" +
        "$inputStream=[System.IO.MemoryStream]::new($compressedBytes);" +
        "$gzipStream=[System.IO.Compression.GZipStream]::new($inputStream,[System.IO.Compression.CompressionMode]::Decompress);" +
        "$reader=[System.IO.StreamReader]::new($gzipStream,[System.Text.Encoding]::UTF8);" +
        "$engineSource=$reader.ReadToEnd();$reader.Dispose();$inputStream.Dispose();" +
        "$engineParameters=@{" +
            "RootFolder=" + quotePowerShellString(options.rootFolder) + ";" +
            "Mode=" + quotePowerShellString(options.mode) + ";" +
            "SearchPattern=" + quotePowerShellString(options.searchPattern) + ";" +
            "ExcludedFolders=" + quotePowerShellString(options.excludedFolders) + ";" +
            "ProgressFile=" + quotePowerShellString(progressFilePath) + ";" +
            "ResultFile=" + quotePowerShellString(resultFilePath) + ";" +
            "ControlFile=" + quotePowerShellString(controlFilePath) + ";" +
            "SelectedFilesFile=" + quotePowerShellString(selectedFilesFilePath) + ";" +
            "RecoveryMode=" + quotePowerShellString(options.recoveryMode) + ";" +
            "CleanupKind=" + quotePowerShellString(options.cleanupKind || "duplicate") + ";" +
            "RecycleBinRoot=" + quotePowerShellString(options.recycleBinRoot || "") + ";" +
            "SearchMinBytes=" + quotePowerShellString(options.searchMinBytes) + ";" +
            "SearchMaxBytes=" + quotePowerShellString(options.searchMaxBytes) + ";" +
            "SearchExtensions=" + quotePowerShellString(options.searchExtensions) + ";" +
            "SearchModifiedAfter=" + quotePowerShellString(options.searchModifiedAfter) + ";" +
            "SearchModifiedBefore=" + quotePowerShellString(options.searchModifiedBefore) + ";" +
            "ReportDirectory=" + quotePowerShellString(options.reportDirectory) +
        "};" +
        "& ([System.Management.Automation.ScriptBlock]::Create($engineSource)) @engineParameters";

    return "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand \"" + encodePowerShellCommand(wrapper) + "\"";
}

function clearProgressFile()
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(fso.FileExists(progressFilePath))
        {
            fso.DeleteFile(progressFilePath, true);
        }
    }
    catch(e)
    {
        // ignore file cleanup errors
    }
}

function clearResultFile()
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(fso.FileExists(resultFilePath))
            fso.DeleteFile(resultFilePath, true);
    }
    catch(e)
    {
    }
}

function clearControlFile()
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(fso.FileExists(controlFilePath))
            fso.DeleteFile(controlFilePath, true);
        if(fso.FileExists(controlFilePath + ".pause"))
            fso.DeleteFile(controlFilePath + ".pause", true);
        if(fso.FileExists(controlFilePath + ".cancel"))
            fso.DeleteFile(controlFilePath + ".cancel", true);
        return true;
    }
    catch(e)
    {
        writeLog("ERROR clearing operation control file: " + e.message);
        return false;
    }
}

function clearPauseControlFile()
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(fso.FileExists(controlFilePath + ".pause"))
            fso.DeleteFile(controlFilePath + ".pause", true);
        return true;
    }
    catch(e)
    {
        writeLog("ERROR resuming operation: " + describeScriptError(e));
        updateStatus("Unable to resume operation");
        return false;
    }
}

function clearSelectedFilesFile()
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(fso.FileExists(selectedFilesFilePath))
            fso.DeleteFile(selectedFilesFilePath, true);
    }
    catch(e)
    {
        writeLog("ERROR clearing selected-file data: " + e.message);
    }
}

function setControlCommand(command)
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var markerPath = controlFilePath + (command === "pause" ? ".pause" : ".cancel");
        if(!fso.FileExists(markerPath))
        {
            var stream = fso.CreateTextFile(markerPath, false, false);
            stream.Close();
        }
        return true;
    }
    catch(e)
    {
        writeLog("ERROR sending operation command: " + e.message);
        updateStatus("Unable to control operation");
        return false;
    }
}

function togglePauseOperation()
{
    if(!progressPollTimer) return;
    if(!operationPaused)
    {
        if(!setControlCommand("pause")) return;
        operationPaused = true;
        operationPausedAt = new Date().getTime();
        setText("operationState", "Pausing");
        updateStatus("Pausing operation");
    }
    else
    {
        if(!clearPauseControlFile()) return;
        operationPausedTotal += Math.max(0, new Date().getTime() - operationPausedAt);
        operationPausedAt = 0;
        operationPaused = false;
        setText("operationState", "Running");
        updateStatus("Resuming operation");
    }
    setOperationControlButtons(true);
}

function cancelOperation()
{
    if(!progressPollTimer) return;
    var message = activeProgressTarget === "cleanup" ?
        "Cancel cleanup? Files already moved will not be restored automatically." :
        "Cancel the running operation? Partial scan results will not be saved.";
    if(!confirm(message)) return;
    if(!setControlCommand("cancel")) return;
    setText("operationState", "Cancelling");
    updateStatus("Cancelling operation...");
}

function setOperationControlButtons(running)
{
    running = running && (activeProgressTarget === "search" || activeProgressTarget === "duplicates" || activeProgressTarget === "largefiles");
    var prefix = activeProgressTarget === "search" ? "search" : activeProgressTarget === "largefiles" ? "largeFiles" : "duplicate";
    var pause = document.getElementById(prefix + "PauseButton");
    var cancel = document.getElementById(prefix + "CancelButton");
    if(pause)
    {
        pause.disabled = !running;
        pause.innerText = operationPaused ? "Resume" : "Pause";
    }
    if(cancel) cancel.disabled = !running;
}

function formatElapsed(milliseconds)
{
    var seconds = Math.floor(Math.max(0, milliseconds) / 1000);
    var minutes = Math.floor(seconds / 60);
    seconds = seconds % 60;
    return "Elapsed " + padNumber(minutes) + ":" + padNumber(seconds);
}

function getOperationElapsedMilliseconds(now)
{
    now = now || new Date().getTime();
    var pausedDuration = operationPausedTotal;
    if(operationPaused && operationPausedAt)
        pausedDuration += Math.max(0, now - operationPausedAt);
    return Math.max(0, now - operationStartedAt - pausedDuration);
}

function readResultFile()
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(!fso.FileExists(resultFilePath)) return null;
        var content = readUtf8File(resultFilePath);
        return content ? JSON.parse(content) : null;
    }
    catch(e)
    {
        return null;
    }
}

function readUtf8File(path)
{
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 2;
    stream.Charset = "utf-8";
    stream.Open();
    stream.LoadFromFile(path);
    var content = stream.ReadText();
    stream.Close();
    return content.replace(/^\uFEFF/, "");
}

function writeUtf8File(path, content)
{
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 2;
    stream.Charset = "utf-8";
    stream.Open();
    stream.WriteText(content);
    stream.SaveToFile(path, 2);
    stream.Close();
}

function restoreSettings()
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(!fso.FileExists(settingsFilePath)) return;
        var settings = JSON.parse(readUtf8File(settingsFilePath));
        var fields = {
            searchRoot:"searchRoot",
            searchText:"searchText",
            searchExcluded:"searchExcluded",
            searchMinSize:"searchMinSize",
            searchMaxSize:"searchMaxSize",
            searchExtensions:"searchExtensions",
            searchModifiedAfter:"searchModifiedAfter",
            searchModifiedBefore:"searchModifiedBefore",
            reportsOutputFolder:"reportsOutputFolder",
            duplicatesRoot:"duplicatesRoot",
            duplicateSearchTerms:"duplicateSearchTerms",
            duplicatesExcluded:"duplicatesExcluded",
            cleanupMethod:"cleanupMethod",
            largeFilesRoot:"largeFilesRoot",
            largeFilesMinSize:"largeFilesMinSize",
            largeFilesMaxSize:"largeFilesMaxSize",
            largeFilesExcluded:"largeFilesExcluded",
            largeFileCleanupMethod:"largeFileCleanupMethod",
            recycleBinScope:"recycleBinScope"
        };
        for(var key in fields)
        {
            if(Object.prototype.hasOwnProperty.call(fields, key) && settings[key] !== undefined)
            {
                var field = document.getElementById(fields[key]);
                if(field) field.value = settings[key];
            }
        }
        recentSearchFolders = settings.recentSearchFolders instanceof Array ? settings.recentSearchFolders : [];
        recentDuplicateFolders = settings.recentDuplicateFolders instanceof Array ? settings.recentDuplicateFolders : [];
        scanProfiles = settings.scanProfiles instanceof Array ? settings.scanProfiles : [];
        renderRecentFolders("search");
        renderRecentFolders("duplicates");
        renderScanProfiles();
    }
    catch(e)
    {
        writeLog("ERROR restoring saved settings: " + e.message);
    }
}

function saveSettings()
{
    try
    {
        var shell = new ActiveXObject("WScript.Shell");
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var directory = shell.ExpandEnvironmentStrings("%APPDATA%") + "\\DuplicateCleaner";
        if(!fso.FolderExists(directory)) fso.CreateFolder(directory);
        var ids = ["searchRoot","searchText","searchExcluded","searchMinSize","searchMaxSize","searchExtensions","searchModifiedAfter","searchModifiedBefore","reportsOutputFolder","duplicatesRoot","duplicateSearchTerms","duplicatesExcluded","cleanupMethod","restoreConflictMode","largeFilesRoot","largeFilesMinSize","largeFilesMaxSize","largeFilesExcluded","largeFileCleanupMethod","recycleBinScope"];
        var settings = {};
        for(var i = 0; i < ids.length; i++)
        {
            var field = document.getElementById(ids[i]);
            if(field) settings[ids[i]] = field.value;
        }
        settings.recentSearchFolders = recentSearchFolders;
        settings.recentDuplicateFolders = recentDuplicateFolders;
        settings.scanProfiles = scanProfiles;
        writeUtf8File(settingsFilePath, JSON.stringify(settings));
    }
    catch(e)
    {
        writeLog("ERROR saving settings: " + e.message);
    }
}

function getScanProfileFieldIds()
{
    return ["searchRoot","searchText","searchExcluded","searchMinSize","searchMaxSize","searchExtensions","searchModifiedAfter","searchModifiedBefore","duplicatesRoot","duplicateSearchTerms","duplicatesExcluded","cleanupMethod","largeFilesRoot","largeFilesMinSize","largeFilesMaxSize","largeFilesExcluded","largeFileCleanupMethod"];
}

function renderScanProfiles()
{
    var select = document.getElementById("scanProfileSelect");
    if(!select) return;
    var markup = '<option value="">Choose a saved profile</option>';
    for(var i = 0; i < scanProfiles.length; i++)
        markup += '<option value="' + i + '">' + escapeHtml(scanProfiles[i].name || ("Profile " + (i + 1))) + '</option>';
    select.innerHTML = markup;
}

function saveScanProfile()
{
    var nameField = document.getElementById("scanProfileName");
    var name = nameField ? (nameField.value || "").replace(/^\s+|\s+$/g, "") : "";
    if(!name)
    {
        updateStatus("Enter a name for the scan profile");
        return;
    }
    var profile = { name:name, values:{} };
    var fieldIds = getScanProfileFieldIds();
    for(var i = 0; i < fieldIds.length; i++)
    {
        var field = document.getElementById(fieldIds[i]);
        if(field) profile.values[fieldIds[i]] = field.value;
    }
    var existingIndex = -1;
    for(var p = 0; p < scanProfiles.length; p++)
        if(String(scanProfiles[p].name || "").toLowerCase() === name.toLowerCase()) existingIndex = p;
    if(existingIndex >= 0) scanProfiles[existingIndex] = profile;
    else scanProfiles.push(profile);
    renderScanProfiles();
    var select = document.getElementById("scanProfileSelect");
    if(select) select.value = String(existingIndex >= 0 ? existingIndex : scanProfiles.length - 1);
    saveSettings();
    updateStatus("Saved scan profile: " + name);
    writeLog("Saved scan profile: " + name);
}

function applyScanProfile()
{
    var select = document.getElementById("scanProfileSelect");
    var index = select ? Number(select.value) : -1;
    if(!select || select.value === "" || !isFinite(index) || !scanProfiles[index]) return;
    var values = scanProfiles[index].values || {};
    var fieldIds = getScanProfileFieldIds();
    for(var i = 0; i < fieldIds.length; i++)
    {
        var field = document.getElementById(fieldIds[i]);
        if(field && values[fieldIds[i]] !== undefined) field.value = values[fieldIds[i]];
    }
    var nameField = document.getElementById("scanProfileName");
    if(nameField) nameField.value = scanProfiles[index].name || "";
    saveSettings();
    updateStatus("Applied scan profile: " + scanProfiles[index].name);
}

function deleteScanProfile()
{
    var select = document.getElementById("scanProfileSelect");
    var index = select ? Number(select.value) : -1;
    if(!select || select.value === "" || !isFinite(index) || !scanProfiles[index])
    {
        updateStatus("Select a saved profile to delete");
        return;
    }
    var name = scanProfiles[index].name || ("Profile " + (index + 1));
    if(!confirm("Delete the saved profile '" + name + "'?")) return;
    scanProfiles.splice(index, 1);
    renderScanProfiles();
    saveSettings();
    updateStatus("Deleted scan profile: " + name);
}

function renderRecentFolders(kind)
{
    var field = document.getElementById(kind === "search" ? "searchRecentFolders" : "duplicatesRecentFolders");
    var folders = kind === "search" ? recentSearchFolders : recentDuplicateFolders;
    if(!field) return;
    var options = '<option value="">Recent folders</option>';
    for(var i = 0; i < folders.length; i++)
        options += '<option value="' + escapeHtml(folders[i]) + '">' + escapeHtml(folders[i]) + '</option>';
    field.innerHTML = options;
}

function rememberRecentFolder(kind, folder)
{
    var folders = kind === "search" ? recentSearchFolders : recentDuplicateFolders;
    for(var i = folders.length - 1; i >= 0; i--)
    {
        if(String(folders[i]).toLowerCase() === folder.toLowerCase())
            folders.splice(i, 1);
    }
    folders.unshift(folder);
    if(folders.length > 5) folders.length = 5;
    renderRecentFolders(kind);
}

function chooseRecentFolder(rootId, recentId)
{
    var recent = document.getElementById(recentId);
    var target = document.getElementById(rootId);
    if(recent && target && recent.value)
    {
        target.value = recent.value;
        saveSettings();
    }
}

function setProgressTarget(target)
{
    activeProgressTarget = target || "dashboard";
    latestProgressMessage = "";
    operationStartedAt = new Date().getTime();
    operationPaused = false;
    operationPausedAt = 0;
    operationPausedTotal = 0;
    var progressIds = { search:"searchProgressbar", duplicates:"progressbar", cleanup:"progressbar", cleanupLarge:"largeFilesProgressbar", largefiles:"largeFilesProgressbar", reports:"reportProgressbar", logs:"logsProgressbar", dashboard:"dashboardProgressbar" };
    var messageIds = { search:"searchProgressMessage", duplicates:"duplicateProgressMessage", cleanup:"duplicateProgressMessage", cleanupLarge:"largeFilesProgressMessage", largefiles:"largeFilesProgressMessage", reports:"reportProgressMessage", logs:"logsProgressMessage", dashboard:"dashboardProgressMessage" };
    var percentIds = { search:"searchProgressPercent", duplicates:"duplicateProgressPercent", cleanup:"duplicateProgressPercent", cleanupLarge:"largeFilesProgressPercent", largefiles:"largeFilesProgressPercent", reports:"reportProgressPercent", logs:"logsProgressPercent", dashboard:"dashboardProgressPercent" };
    var countIds = { search:"searchMatchCount", duplicates:"duplicateCountStatus", cleanup:"duplicateCountStatus", cleanupLarge:"largeFilesCount", largefiles:"largeFilesCount" };
    var progress = document.getElementById(progressIds[activeProgressTarget] || progressIds.dashboard);
    if(progress) progress.style.width = "0%";

    setText(messageIds[activeProgressTarget] || messageIds.dashboard, "Starting operation...");
    setText(percentIds[activeProgressTarget] || percentIds.dashboard, "0%");
    if(activeProgressTarget === "search" || activeProgressTarget === "duplicates" || activeProgressTarget === "largefiles")
    {
        var checkedId = activeProgressTarget === "search" ? "searchFilesChecked" : activeProgressTarget === "largefiles" ? "largeFilesChecked" : "duplicateFilesChecked";
        var elapsedId = activeProgressTarget === "search" ? "searchElapsed" : activeProgressTarget === "largefiles" ? "largeFilesElapsed" : "duplicateElapsed";
        setText(checkedId, "0 files checked");
        setText(elapsedId, "Elapsed 00:00");
    }
    if(countIds[activeProgressTarget])
        setText(countIds[activeProgressTarget], activeProgressTarget === "search" ? "0 matches" : (activeProgressTarget === "largefiles" || activeProgressTarget === "cleanupLarge") ? "0 files" : "0 duplicates");
    setOperationControlButtons(true);
    if(activeProgressTarget === "duplicates" || activeProgressTarget === "cleanup" || activeProgressTarget === "cleanupLarge" || activeProgressTarget === "largefiles")
    {
        var deleteButton = document.getElementById(activeProgressTarget === "largefiles" || activeProgressTarget === "cleanupLarge" ? "removeLargeFilesButton" : "deleteDuplicatesButton");
        if(deleteButton) deleteButton.disabled = true;
    }
    setText("operationState", "Running");
}

function readProgressFile()
{
    try
    {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(!fso.FileExists(progressFilePath))
            return null;

        var content = readUtf8File(progressFilePath);

        if(!content || !content.trim())
            return null;

        var lines = content.split(/\r?\n/).filter(function(line){
            return line && line.trim();
        });

        if(lines.length === 0)
            return null;

        var lastLine = lines[lines.length - 1];
        return JSON.parse(lastLine);
    }
    catch(e)
    {
        return null;
    }
}

function renderOperationFailure(target, message)
{
    var detail = message || "Operation failed. See activity log for details.";

    if(target === "search")
        setEmptyRow("searchResults", 4, detail);
    else if(target === "duplicates")
    {
        setEmptyRow("duplicateResults", 5, detail);
        var deleteButton = document.getElementById("deleteDuplicatesButton");
        if(deleteButton) deleteButton.disabled = true;
    }
    else if(target === "reports")
    {
        setEmptyRow("reportResults", 3, detail);
        setText("reportStatus", "Failed");
        setText("reportLocation", detail);
    }
    else if(target === "logs")
        setEmptyRow("logsResults", 3, detail);
    else if(target === "largefiles")
    {
        setEmptyRow("largeFilesResults", 6, detail);
        setText("largeFilesProgressMessage", detail);
        var removeButton = document.getElementById("removeLargeFilesButton");
        if(removeButton) removeButton.disabled = true;
    }
}

function pollProgress()
{
    try
    {
        var data = readProgressFile();

        if(!data)
            return;

        var progressIds = { search:"searchProgressbar", duplicates:"progressbar", cleanup:"progressbar", cleanupLarge:"largeFilesProgressbar", largefiles:"largeFilesProgressbar", reports:"reportProgressbar", logs:"logsProgressbar", dashboard:"dashboardProgressbar" };
        var messageIds = { search:"searchProgressMessage", duplicates:"duplicateProgressMessage", cleanup:"duplicateProgressMessage", cleanupLarge:"largeFilesProgressMessage", largefiles:"largeFilesProgressMessage", reports:"reportProgressMessage", logs:"logsProgressMessage", dashboard:"dashboardProgressMessage" };
        var percentIds = { search:"searchProgressPercent", duplicates:"duplicateProgressPercent", cleanup:"duplicateProgressPercent", cleanupLarge:"largeFilesProgressPercent", largefiles:"largeFilesProgressPercent", reports:"reportProgressPercent", logs:"logsProgressPercent", dashboard:"dashboardProgressPercent" };
        var countIds = { search:"searchMatchCount", duplicates:"duplicateCountStatus", cleanup:"duplicateCountStatus", cleanupLarge:"largeFilesCount", largefiles:"largeFilesCount" };
        var progress = document.getElementById(progressIds[activeProgressTarget] || progressIds.dashboard);

        if(progress)
        {
            progress.style.width =
                (data.percent || 0) + "%";
        }

        setText(messageIds[activeProgressTarget] || messageIds.dashboard, data.message || data.stage || "Working...");
        setText(percentIds[activeProgressTarget] || percentIds.dashboard, (data.percent || 0) + "%");
        if(countIds[activeProgressTarget] && data.count !== null && data.count !== undefined)
            setText(countIds[activeProgressTarget], data.count + (activeProgressTarget === "search" ? " matches" : " files"));
        if((activeProgressTarget === "search" || activeProgressTarget === "duplicates" || activeProgressTarget === "largefiles") && data.checked !== null && data.checked !== undefined)
            setText(activeProgressTarget === "search" ? "searchFilesChecked" : activeProgressTarget === "largefiles" ? "largeFilesChecked" : "duplicateFilesChecked", data.checked + " files checked");
        if(operationStartedAt && (activeProgressTarget === "search" || activeProgressTarget === "duplicates" || activeProgressTarget === "largefiles"))
            setText(activeProgressTarget === "search" ? "searchElapsed" : activeProgressTarget === "largefiles" ? "largeFilesElapsed" : "duplicateElapsed", formatElapsed(getOperationElapsedMilliseconds()));
        setText("operationState", data.stage || "Running");

        if(data.message)
        {
            updateStatus(data.stage + ": " + data.message);
            if(latestProgressMessage !== data.stage)
            {
                latestProgressMessage = data.stage;
                writeLog(data.stage + ": " + data.message);
            }
        }

        if(data.stage && (data.stage.toLowerCase() === "completed" || data.stage.toLowerCase() === "failed" || data.stage.toLowerCase() === "cancelled"))
        {
            if(data.stage.toLowerCase() === "completed")
            {
                var resultData = readResultFile();
                if(resultData) renderResultData(resultData);
                else
                {
                    var failedTarget = activeProgressTarget === "cleanup" ? "duplicates" : activeProgressTarget === "cleanupLarge" ? "largefiles" : activeProgressTarget;
                    var resultError = "Operation finished, but its results could not be read. Check the operation log.";
                    renderOperationFailure(failedTarget, resultError);
                    if(activeProgressTarget === "duplicates" || activeProgressTarget === "cleanup")
                    {
                        latestDuplicateGroups = [];
                        duplicateSelectedPaths = {};
                        setText("scanAnalysisSummary", resultError);
                    }
                    setText("operationState", "Result error");
                    updateStatus(resultError);
                    writeLog("ERROR: " + resultError);
                }
            }
            else if(data.stage.toLowerCase() === "cancelled")
            {
                if(activeProgressTarget === "search")
                    setEmptyRow("searchResults", 4, "Search cancelled. Partial results were not saved.");
                else if(activeProgressTarget === "duplicates")
                    setText("duplicateProgressMessage", "Scan cancelled. Existing results were kept.");
                else if(activeProgressTarget === "largefiles")
                    setText("largeFilesProgressMessage", "Scan cancelled. Existing results were kept.");
                else if(activeProgressTarget === "cleanup" || activeProgressTarget === "cleanupLarge")
                {
                    var cleanupData = readResultFile();
                    if(cleanupData) renderResultData(cleanupData);
                }
                updateStatus("Operation cancelled");
            }
            else
            {
                renderOperationFailure(activeProgressTarget === "cleanup" ? "duplicates" : activeProgressTarget === "cleanupLarge" ? "largefiles" : activeProgressTarget, data.message || "Operation failed.");
            }
            setText("operationState", data.stage);
            if(progressPollTimer)
            {
                clearInterval(progressPollTimer);
                progressPollTimer = null;
            }
            operationPaused = false;
            operationPausedAt = 0;
            setOperationControlButtons(false);
            clearSelectedFilesFile();
            if((activeProgressTarget === "duplicates" && data.stage.toLowerCase() !== "failed") ||
                (activeProgressTarget === "cleanup" && data.stage.toLowerCase() === "completed"))
            {
                var remainingCandidates = renderDuplicateResults();
                if(data.stage.toLowerCase() === "cancelled")
                    setText("duplicateCountStatus", remainingCandidates + " duplicates (previous results)");
            }
            if(activeProgressTarget === "cleanupLarge")
                renderLargeFileResults();
        }
    }
    catch(e)
    {
        var progressError = describeScriptError(e);
        writeLog("ERROR updating operation progress: " + progressError);
        updateStatus("Unable to update operation progress: " + progressError);
        stopProgressPolling();
        operationPaused = false;
        setOperationControlButtons(false);
        setText("operationState", "UI error");
    }
}

function startProgressPolling()
{
    if(progressPollTimer)
    {
        clearInterval(progressPollTimer);
    }

    progressPollTimer = setInterval(pollProgress, 500);
}

function stopProgressPolling()
{
    if(progressPollTimer)
    {
        clearInterval(progressPollTimer);
        progressPollTimer = null;
    }
}

function runScan(targetId)
{
    try
    {
        if(progressPollTimer)
        {
            writeLog("An operation is already running. Wait for it to finish before starting another.");
            updateStatus("Operation already running");
            return;
        }
        var folderValue =
            getFolderValue(
                targetId || "folder"
            );

        if(!folderValue || !folderValue.trim())
        {
            logFailedOperation("Scan", "", "A folder path is required.");
            writeLog("ERROR: Please select a valid root folder.");
            renderOperationFailure("duplicates", "Please select a folder to scan.");
            updateStatus("Folder required");
            return;
        }

        if(!folderExists(folderValue))
        {
            var folderError = "Folder not found: " + folderValue;
            logFailedOperation("Scan", folderValue, folderError);
            renderOperationFailure("duplicates", folderError);
            writeLog("ERROR: " + folderError);
            updateStatus("Folder not found");
            return;
        }

        rememberRecentFolder("duplicates", folderValue);
        var duplicateKeywords = getKeywordValue("duplicateSearchTerms");
        var scanDetails = "Duplicate keywords: " + (duplicateKeywords || "(all files)") + "\r\n" +
            "Exclusions: " + getExclusionValue("duplicatesExcluded");
        if(!startOperationLog("Scan", folderValue, scanDetails))
        {
            writeLog("ERROR: Could not create an operation log in the logs folder.");
            return;
        }

        clearProgressFile();
        clearResultFile();
        clearControlFile();
        clearSelectedFilesFile();
        saveSettings();
        setProgressTarget(targetId ? "duplicates" : "dashboard");

        updateStatus("Preparing scan");
        writeLog("Starting background scan for: " + folderValue);

        var command = createEmbeddedPowerShellCommand({
            rootFolder: folderValue,
            mode: "Scan",
            searchPattern: duplicateKeywords,
            excludedFolders: getExclusionValue("duplicatesExcluded"),
            deleteDuplicates: false
        });

        var shell = new ActiveXObject("WScript.Shell");
        shell.Run(command, 0, false);
        startProgressPolling();

        updateStatus("Scan started");
    }
    catch(e)
    {
        stopProgressPolling();
        operationPaused = false;
        setOperationControlButtons(false);
        var scanError = describeScriptError(e);
        writeLog("ERROR: " + scanError);
        updateStatus("Scan failed: " + scanError);
    }
}

function searchItems()
{
    if(progressPollTimer)
    {
        writeLog("An operation is already running.");
        updateStatus("Operation already running");
        return;
    }

    var search =
        document.getElementById(
            "searchText"
        ).value;
    search = getKeywordValue("searchText");

    var folder =
        getFolderValue("searchRoot");

    if(!search || !search.trim())
    {
        logFailedOperation("Search", getFolderValue("searchRoot"), "Search term is required.");
        writeLog("ERROR: Please enter a search term.");
        updateStatus("Search term required");
        return;
    }

    if(!folder || !folder.trim())
    {
        logFailedOperation("Search", "", "A folder path is required.", "Search term: " + search);
        writeLog("ERROR: Please select a folder to search.");
        renderOperationFailure("search", "Please select a folder to search.");
        updateStatus("Folder required");
        return;
    }

    if(!folderExists(folder))
    {
        var folderError = "Folder not found: " + folder;
        logFailedOperation("Search", folder, folderError, "Search term: " + search);
        renderOperationFailure("search", folderError);
        writeLog("ERROR: " + folderError);
        updateStatus("Folder not found");
        return;
    }

    var filters;
    try
    {
        filters = getSearchFilterOptions();
    }
    catch(e)
    {
        updateStatus(e.message);
        writeLog("ERROR: " + e.message);
        return;
    }

    rememberRecentFolder("search", folder);
    latestSearchRows = [];
    searchSelectedPaths = {};
    setText("searchResultSummary", "0 shown; 0 total");
    setEmptyRow("searchResults", 4, "Searching...");
    saveSettings();

    runPowerShellCommand(
        "Search",
        {
            rootFolder: folder,
            searchPattern: search,
            excludedFolders: getExclusionValue("searchExcluded"),
            searchMinBytes: filters.searchMinBytes,
            searchMaxBytes: filters.searchMaxBytes,
            searchExtensions: filters.searchExtensions,
            searchModifiedAfter: filters.searchModifiedAfter,
            searchModifiedBefore: filters.searchModifiedBefore
        }
    );

    writeLog("Searching: " + search + " in " + folder);
}

function runReports(targetId)
{
    if(progressPollTimer)
    {
        writeLog("An operation is already running.");
        updateStatus("Operation already running");
        return;
    }

    var folderValue =
        getFolderValue(targetId || "reportsRoot");
    var reportDirectoryField = document.getElementById("reportsOutputFolder");
    var reportDirectory = reportDirectoryField ? (reportDirectoryField.value || "").replace(/^\s+|\s+$/g, "") : "";

    if(!folderValue || !folderValue.trim())
    {
        writeLog("ERROR: Please select a report folder.");
        updateStatus("Folder required");
        return;
    }

    if(reportDirectory && !folderExists(reportDirectory))
    {
        writeLog("ERROR: Report output folder not found: " + reportDirectory);
        updateStatus("Report output folder not found");
        return;
    }

    runPowerShellCommand(
        "Reports",
        {
            rootFolder: folderValue,
            searchPattern: targetId === "duplicatesRoot" ? getKeywordValue("duplicateSearchTerms") : "",
            excludedFolders: targetId === "duplicatesRoot" ? getExclusionValue("duplicatesExcluded") : "",
            reportDirectory: reportDirectory
        }
    );
}

function renderQuarantineBatches(batches)
{
    var selector = document.getElementById("quarantineBatchSelect");
    var options = '<option value="">All batches</option>';
    batches.sort(function(left, right){ return String(right.createdAt).localeCompare(String(left.createdAt)); });
    for(var i = 0; i < batches.length; i++)
        options += '<option value="' + escapeHtml(batches[i].batchId) + '">' + escapeHtml(batches[i].batchId) + " (" + escapeHtml(batches[i].itemCount) + ")" + '</option>';
    selector.innerHTML = options;
    renderQuarantineRows("");
}

function renderQuarantineRows(batchId)
{
    var target = document.getElementById("quarantineResults");
    var rows = "";
    var availableCount = 0;
    var filteredCount = 0;
    var selectedCount = 0;
    for(var i = 0; i < latestQuarantineRows.length; i++)
    {
        var item = latestQuarantineRows[i];
        if(batchId && item.BatchId !== batchId) continue;
        filteredCount++;
        if(item.Available) availableCount++;
        if(quarantineSelectedPaths[item.QuarantinedPath]) selectedCount++;
        rows += '<tr><td><input type="checkbox" onchange="toggleQuarantineSelection(' + i + ',this.checked)"' +
            (item.Available ? "" : " disabled") +
            (quarantineSelectedPaths[item.QuarantinedPath] ? " checked" : "") +
            '></td><td>' + escapeHtml(item.Status) + (item.Available ? "" : " (unavailable)") +
            '</td><td title="' + escapeHtml(item.OriginalPath) + '">' + escapeHtml(item.OriginalPath) +
            '</td><td title="' + escapeHtml(item.QuarantinedPath) + '">' + escapeHtml(item.QuarantinedPath) +
            '</td><td>' + formatBytes(item.Length) + '</td></tr>';
    }
    target.innerHTML = rows || '<tr><td class="empty-state" colspan="5">No quarantine entries in this batch.</td></tr>';
    setText("quarantineSummary", filteredCount + " entries; " + availableCount + " available; " + selectedCount + " selected.");
}

function showQuarantineBatch(batchId)
{
    renderQuarantineRows(batchId || "");
}

function toggleQuarantineSelection(index, selected)
{
    var item = latestQuarantineRows[index];
    if(!item || !item.Available) return;
    if(selected) quarantineSelectedPaths[item.QuarantinedPath] = true;
    else delete quarantineSelectedPaths[item.QuarantinedPath];
    renderQuarantineRows(document.getElementById("quarantineBatchSelect").value || "");
}

function loadQuarantineBatches()
{
    if(progressPollTimer) return;
    var quarantineDirectory;
    try
    {
        quarantineDirectory = ensureApplicationQuarantineDirectory();
    }
    catch(e)
    {
        writeLog("ERROR accessing application quarantine: " + e.message);
        updateStatus("Quarantine unavailable");
        return;
    }
    runPowerShellCommand("ListQuarantine", { rootFolder:quarantineDirectory });
}

function restoreSelectedQuarantine()
{
    if(progressPollTimer) return;
    var selected = [];
    for(var i = 0; i < latestQuarantineRows.length; i++)
    {
        var item = latestQuarantineRows[i];
        if(item.Available && quarantineSelectedPaths[item.QuarantinedPath])
            selected.push({ BatchFolder:item.BatchFolder, QuarantinedPath:item.QuarantinedPath, OriginalPath:item.OriginalPath });
    }
    if(!selected.length)
    {
        updateStatus("Select quarantined files to restore");
        return;
    }
    var modeField = document.getElementById("restoreConflictMode");
    var recoveryMode = modeField ? modeField.value : "rename";
    var conflictText = recoveryMode === "rename" ? "Existing original files will be preserved; restored copies will get a new name." : "Files with occupied original paths will be skipped.";
    if(!confirm("Restore " + selected.length + " selected file(s)?\r\n" + conflictText))
        return;
    runPowerShellCommand("RestoreSelected", {
        rootFolder:ensureApplicationQuarantineDirectory(),
        selectedFilesJson:JSON.stringify(selected),
        recoveryMode:recoveryMode
    });
}

function runLogAction(targetId)
{
    if(progressPollTimer)
    {
        writeLog("An operation is already running.");
        updateStatus("Operation already running");
        return;
    }

    var folderValue =
        getFolderValue(targetId || "logsRoot");

    runPowerShellCommand(
        "Logs",
        { rootFolder: folderValue }
    );
}

function deleteSelected()
{
    var selected = getSelectedDuplicateFiles();
    if(!selected.length)
    {
        updateStatus("Select copies to remove");
        return;
    }

    var methodField = document.getElementById("cleanupMethod");
    var recoveryMode = methodField ? methodField.value : "recycle";
    var destination = recoveryMode === "quarantine" ? "the application quarantine" :
        recoveryMode === "permanent" ? "permanently delete them" : "the Recycle Bin";
    var totalBytes = 0;
    var confidentlyReclaimableBytes = 0;
    var keeperPaths = [];
    for(var i = 0; i < selected.length; i++)
    {
        totalBytes += selected[i].Length;
        if(selected[i].HardLinkCount === 1) confidentlyReclaimableBytes += selected[i].Length;
        if(keeperPaths.indexOf(selected[i].KeepPath) < 0) keeperPaths.push(selected[i].KeepPath);
    }
    var preview = "Process " + selected.length + " duplicate file(s), " + formatBytes(totalBytes) + " total data size.\r\nEstimated space recoverable by permanent deletion: " + formatBytes(confidentlyReclaimableBytes) + ".\r\nDestination: " + destination + ".\r\nThe selected keeper in each group will be protected.";
    if(recoveryMode === "recycle")
        preview += "\r\nThe files may continue using disk space until the Recycle Bin on their drive is emptied.";
    else if(recoveryMode === "quarantine")
        preview += "\r\nQuarantine may use storage on the same drive.";
    if(keeperPaths.length)
    {
        preview += "\r\n\r\nKeep copies:\r\n";
        var keeperLimit = Math.min(5, keeperPaths.length);
        for(var k = 0; k < keeperLimit; k++) preview += keeperPaths[k] + "\r\n";
        if(keeperPaths.length > keeperLimit) preview += "...and " + (keeperPaths.length - keeperLimit) + " more.";
    }
    if(!confirm(preview + "\r\n\r\nContinue?"))
        return;
    if(recoveryMode === "permanent")
    {
        var acknowledgement = prompt("Permanent deletion cannot be undone. Type DELETE to confirm.");
        if(acknowledgement !== "DELETE")
        {
            updateStatus("Permanent deletion cancelled");
            return;
        }
    }

    saveSettings();
    runPowerShellCommand("DeleteSelected", {
        rootFolder: getFolderValue("duplicatesRoot"),
        searchPattern: "",
        excludedFolders: getExclusionValue("duplicatesExcluded"),
        selectedFilesJson: JSON.stringify(selected),
        recoveryMode: recoveryMode
    });
    writeLog("Processing " + selected.length + " selected duplicate file(s): " + destination + ".");
}

function emptyRecycleBin()
{
    if(progressPollTimer)
    {
        updateStatus("Wait for the current operation to finish before emptying the Recycle Bin");
        return;
    }
    var scopeField = document.getElementById("recycleBinScope");
    var scope = scopeField ? scopeField.value : "scanDrive";
    updateRecycleBinScopeSummary();
    var rootPath = "ALL";
    var description = "all drives";
    if(scope !== "allDrives")
    {
        var scanFolder = getFolderValue("duplicatesRoot");
        var driveMatch = /^([A-Za-z]:\\)/.exec(scanFolder);
        if(!driveMatch)
        {
            updateStatus("Select a local drive scan folder or choose all drives");
            return;
        }
        rootPath = driveMatch[1];
        description = rootPath;
    }
    if(!confirm("Permanently delete all items in the Recycle Bin for " + description + "?\r\n\r\nThis cannot be undone."))
        return;
    runPowerShellCommand("EmptyRecycleBin", { rootFolder:"Recycle Bin", recycleBinRoot:rootPath });
}

function updateRecycleBinScopeSummary()
{
    var field = document.getElementById("recycleBinScope");
    var scope = field ? field.value : "scanDrive";
    if(scope === "allDrives")
        setText("recycleBinScopeSummary", "Warning: All Recycle Bin contents on every drive will be permanently deleted.");
    else
    {
        var match = /^([A-Za-z]:\\)/.exec(getFolderValue("duplicatesRoot"));
        setText("recycleBinScopeSummary", match ?
            "Only the Recycle Bin on " + match[1] + " will be emptied." :
            "Scope follows the drive containing the selected duplicate scan folder.");
    }
}

function showPage(pageId,element)
{
    var pages =
        document.getElementsByClassName(
            "page"
        );

    for(var i=0;i<pages.length;i++)
    {
        pages[i].style.display =
            "none";
    }

    document.getElementById(
        pageId
    ).style.display =
        "block";

    var nav =
        document.getElementsByClassName(
            "nav-item"
        );

    for(var j=0;j<nav.length;j++)
    {
        nav[j].className =
            "nav-item";
    }

    element.className =
        "nav-item active";
}

function syncLayout()
{
    var header =
        document.querySelector(
            ".header"
        );

    var status =
        document.getElementById(
            "statusText"
        );

    var container =
        document.querySelector(
            ".container"
        );

    if(!header || !container)
        return;

    var headerHeight =
        header.offsetHeight || 72;

    var statusHeight =
        status ? status.offsetHeight : 32;

    var viewportHeight =
        window.innerHeight ||
        document.documentElement.clientHeight ||
        screen.availHeight;

    var targetHeight =
        Math.max(
            viewportHeight - headerHeight - statusHeight,
            420
        );

    container.style.height =
        targetHeight + "px";
}

window.addEventListener(
    "resize",
    syncLayout
);

window.onload=function()
{
    syncLayout();
    restoreSettings();

    try
    {
        document.getElementById("logsRoot").value = ensureApplicationLogDirectory();
    }
    catch(e)
    {
        writeLog("ERROR creating application log folder: " + e.message);
    }

    setEmptyRow("searchResults", 4, "Run a search to see matching files.");
    setEmptyRow("duplicateResults", 5, "Run a preview to see duplicate candidates.");
    setEmptyRow("largeFilesResults", 6, "Run a large-file scan to see eligible files.");
    setEmptyRow("reportResults", 3, "Generate a CSV to review duplicate candidates.");
    setEmptyRow("logsResults", 3, "Load log files from a selected folder.");
    setText("searchResultSummary", "0 results");
    setText("duplicateResultSummary", "0 groups");
    setText("duplicateSelectionSummary", "0 selected; 0 removable copies");
    setText("largeFilesSummary", "0 files");
    setText("largeFileSelectionSummary", "0 selected; estimated reclaim 0 B.");
    renderScanProfiles();
    updateRecycleBinScopeSummary();

    var settingsFields = ["searchRoot","searchText","searchExcluded","searchMinSize","searchMaxSize","searchExtensions","searchModifiedAfter","searchModifiedBefore","reportsOutputFolder","duplicatesRoot","duplicateSearchTerms","duplicatesExcluded","cleanupMethod","restoreConflictMode","largeFilesRoot","largeFilesMinSize","largeFilesMaxSize","largeFilesExcluded","largeFileCleanupMethod","recycleBinScope"];
    for(var i = 0; i < settingsFields.length; i++)
    {
        var settingsField = document.getElementById(settingsFields[i]);
        if(settingsField) settingsField.onchange = saveSettings;
    }

    writeLog(
        "Application Ready"
    );
};

</script>

</body>
</html>
